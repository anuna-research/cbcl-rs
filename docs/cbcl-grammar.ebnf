(* ================================================================== *)
(* CBCL — Common Business Communication Language                       *)
(* EBNF Grammar (extracted from cbcl-rs canonical implementation)      *)
(*                                                                     *)
(* Parser class: DCFL (Deterministic Context-Free Language)            *)
(* Time complexity: O(n), no backtracking, fuel-bounded recursion      *)
(*                                                                     *)
(* Reference: crates/cbcl-parser/src/parser.rs          (layer 1)      *)
(*            crates/cbcl-core/src/message.rs           (layer 2)      *)
(*            crates/cbcl-parser/src/dialect_parser.rs  (layer 3)      *)
(*            crates/cbcl-parser/src/protocol_parser.rs (contracts)    *)
(*            crates/cbcl-parser/src/shape_parser.rs    (contracts)    *)
(*            lean-cbcl/LeanCbcl/Parser.lean            (formal model) *)
(*                                                                     *)
(* The normative prose specification is IETF/draft-oconnor-cbcl.md.    *)
(* Where this file and the draft disagree, the draft is authoritative; *)
(* where either disagrees with the sources above, they are.            *)
(* ================================================================== *)


(* ================================================================== *)
(* Layer 1: S-expression syntax                                        *)
(*                                                                     *)
(* Input MUST be well-formed UTF-8. A complete input is exactly one    *)
(* S-expression; trailing non-whitespace content is an error.          *)
(* ================================================================== *)

input           = ws , expression , ws ;

expression      = list
                | string
                | boolean
                | keyword
                | numeric
                | symbol ;

list            = "(" , { ws , expression } , ws , ")" ;

(* -- Atoms --------------------------------------------------------- *)

symbol          = symbol-char , { symbol-char } ;

(* NOTE: ':' , ';' , '#' , '&' , '[' , ']' and '\' are NOT symbol      *)
(* characters. Canonical content addresses use the symbol-safe SHA2-256 *)
(* multihash spelling "f1220" followed by 64 lowercase hex digits.     *)
symbol-char     = letter | digit
                | "_" | "-" | "." | "/" | "!" | "?"
                | "+" | "*" | "<" | ">" | "=" | "@" ;

(* Digit-led tokens (including '-' followed by a digit) consume to    *)
(* whitespace, a parenthesis, a quote, a comment marker, or EOF.       *)
(* The whole token must match numeric, with the range checks below.   *)
(* '-' not followed by a digit starts a symbol: '-', '-a', '--3',      *)
(* and '->' are symbols. '+1.0', '.5', and '-.5' are symbols too.       *)
numeric         = number | float | decimal ;
number          = [ "-" ] , digits ;                         (* i64 *)
float           = [ "-" ] , digits ,
                  ( fraction , [ exponent ] | exponent ) ;
fraction        = "." , { digit } ;
exponent        = ( "e" | "E" ) , [ "+" | "-" ] , digits ;
decimal         = [ "-" ] , digits , [ "." , digits ] , "m" ;
digits          = digit , { digit } ;

(* Floats decode to finite IEEE 754 binary64; overflow is rejected.    *)
(* Examples: 1.25, 1., 1.e2, 1e-3. Decimals are exact, arbitrary-     *)
(* precision values: 12m, 12.3400m. The suffix is lowercase 'm';       *)
(* decimal exponents and a trailing decimal point are rejected.      *)
(* 'number' remains integer-only in resource bounds, counter amounts, *)
(* repeat counts, finite-lattice tables and threshold forms.         *)
(* The current Lean atom/parser model covers the integer fragment;    *)
(* float/decimal recognition and canonicalization are Rust extensions.*)

string          = '"' , { string-char | escape } , '"' ;

string-char     = ? any Unicode scalar value except '"' and '\' ? ;

(* Any other escape is a typed rejection, never preserved literally. *)
escape          = "\" , ( '"' | "\" | "n" | "r" | "t" ) ;

boolean         = ( "#t" | "#f" ) , ? followed by a delimiter ? ;
                  (* the delimiter check is specified but not yet
                     enforced by the reference parser — see BUG-005 *)

keyword         = ":" , symbol-char , { symbol-char } ;

(* -- Whitespace & comments ----------------------------------------- *)

ws              = { ws-char | comment } ;

ws-char         = " " | "\t" | "\n" | "\r" | "\f" ;

comment         = ";" , { ? any character except '\n' ? } , [ "\n" ] ;
                  (* end of input also terminates a comment *)

letter          = ? ASCII A-Z, a-z ? ;

digit           = ? ASCII 0-9 ? ;


(* ================================================================== *)
(* Layer 2: CBCL message grammar                                       *)
(*                                                                     *)
(* Dispatch is deterministic by head symbol (msgTag in Lean):          *)
(*   "meta"        -> meta-message                                     *)
(*   "lang"        -> dialect-message      (HeadAndSecond tag)         *)
(*   "envelope"    -> wrapped-message                                  *)
(*   "signed"      -> wrapped-message                                  *)
(*   "with-limits" -> wrapped-message                                  *)
(*   "with-roles"  -> wrapped-message                                  *)
(*   otherwise     -> simple-message                                   *)
(*                                                                     *)
(* The head MUST be a symbol; an empty list or a non-symbol head is    *)
(* rejected.                                                           *)
(* ================================================================== *)

message         = simple-message
                | meta-message
                | dialect-message
                | wrapped-message ;


(* -- Simple message ------------------------------------------------ *)
(* (performative [recipients] [content] [:key value ...])              *)

simple-message  = "(" , core-performative , message-tail , ")" ;

custom-message  = "(" , custom-performative , message-tail , ")" ;

message-tail    = [ ws , recipients ]
                      , [ ws , content ]
                      , { ws , param } ;

(* Only the scoped productions admit custom-message. Wrappers carry  *)
(* that context through; a nested lang selects its own dialect.      *)
scoped-message  = simple-message | custom-message | meta-message
                | dialect-message | scoped-wrapped-message ;

core-performative
                = "tell" | "ask" | "reply" | "error"
                | "ok"   | "cancel" | "hello" | "bye" ;

custom-performative
                = symbol ;    (* excludes reserved heads and core names;
                                 requires an enclosing (lang ...) *)

(* Recognised only in the position immediately after the performative. *)
recipients      = address | address-group ;

address         = "@" , symbol-char , { symbol-char } ;

address-group   = "(" , address , { ws , address } , ")" ;   (* non-empty;
                     serialised in ascending lexicographic order *)

content         = expression ;
                  (* MUST NOT be an address or an address-group *)

param           = keyword-param | positional-param ;

positional-param = expression ;
                  (* MUST NOT be an address or an address-group *)

keyword-param   = reserved-param | user-param ;

user-param      = keyword , ws , expression ;

(* -- Reserved keyword parameters ----------------------------------- *)
(* Lifted out of the parameter list into structured message fields.    *)

reserved-param  = ":thread" , ws , ( string | symbol )
                | ":sender" , ws , ( string | symbol )
                | ":caused-by" , ws , caused-by-value ;

caused-by-value = begin-ref | hash-ref | hash-list ;

begin-ref       = "begin" | '"begin"' ;

hash-ref        = string | symbol ;    (* a content address; canonical wire
                                          text is f1220<64 lowercase hex> *)

hash-list       = "(" , hash-ref , { ws , hash-ref } , ")" ;  (* non-empty;
                     stored in ascending lexicographic order *)


(* -- Meta message -------------------------------------------------- *)
(* (meta <operation>) — trailing elements are currently ignored        *)

meta-message    = "(" , "meta" , ws , meta-operation
                      , { ws , expression } , ")" ;

meta-operation  = meta-query | meta-teach | dialect-definition
                | expression ;

meta-query      = "(" , "query" , ws , expression , ")" ;

meta-teach      = "(" , "teach" , ws , address , ws , expression , ")" ;


(* -- Dialect-scoped message ---------------------------------------- *)
(* (lang <dialect-name> <inner-message>)                               *)

dialect-message = "(" , "lang" , ws , dialect-name
                      , ws , scoped-message
                      , { ws , expression } , ")" ;

dialect-name    = symbol ;


(* -- Wrapped message ----------------------------------------------- *)
(* (wrapper-type <params...> <inner-message>)                          *)
(* The inner message is the LAST list-valued element; everything       *)
(* before it is a wrapper parameter. Atoms after it are ignored.       *)

wrapped-message = "(" , wrapper-type
                      , { ws , wrapper-param }
                      , ws , message
                      , { ws , atom } , ")" ;

scoped-wrapped-message = "(" , wrapper-type
                      , { ws , wrapper-param }
                      , ws , scoped-message
                      , { ws , atom } , ")" ;

wrapper-type    = "envelope" | "signed" | "with-limits" | "with-roles" ;

wrapper-param   = expression ;

(* with-roles carries the thread cast (SPEC-014 CON-601, REQ-628):     *)
(*   (with-roles (<binding>+) [:dialect <pin>] <inner-message>)        *)
(*   binding = "(" role-name , key , { key } , ")"                     *)
(* pin is a string or symbol whose value is canonical SHA2-256         *)
(* multihash text: "f1220" plus exactly 64 lowercase hex digits.       *)
(* A singleton role takes exactly one key; an indexed role one or more.*)


(* ================================================================== *)
(* Layer 3: Dialect definition grammar                                 *)
(*                                                                     *)
(* Entered via (meta (define ...)), (meta (teach @peer ...)), or a      *)
(* standalone (define ...) form.                                       *)
(* Reference: crates/cbcl-parser/src/dialect_parser.rs                 *)
(* ================================================================== *)

dialect-definition
                = "(" , "define" , ws , dialect-name
                      , ws , extends-list
                      , ws , author
                      , { ws , dialect-clause }
                      , ")" ;

extends-list    = "(" , { ws , symbol } , ")" ;

author          = symbol | string ;      (* conventionally "@name" *)

(* An unrecognised keyword clause is a typed rejection, never ignored. *)
dialect-clause  = extend-clause
                | protocol-clause
                | shape-clause
                | type-decl
                | resource-clause
                | examples-clause
                | signature-clause
                | hash-clause
                | sig-algorithm-clause
                | roles-clause
                | causal-locality-clause
                | state-clause | state-bounds-clause ;

(* -- Performative extension ---------------------------------------- *)
(* Exactly one template form. :from/:to may appear before or after it, *)
(* and must both be present or both absent.                            *)

extend-clause   = "(" , "extend" , ws , perf-name
                      , ws , param-list
                      , ( ws , extend-item ) , { ws , extend-item }
                      , ")" ;

extend-item     = role-from | role-to | template ;

role-from       = ":from" , ws , role-name ;
role-to         = ":to"   , ws , ( role-name | role-set ) ;
role-set        = "(" , { ws , role-name } , ")" ;   (* may be empty *)

perf-name       = symbol ;
role-name       = symbol ;

param-list      = "(" , { ws , symbol } , ")" ;
                  (* bound POSITIONALLY; there is no &key marker —
                     '&' is not a symbol-char. An unbound parameter
                     survives into the expansion as a bare symbol. *)

template        = expression ;

(* -- Template language (crates/cbcl-core/src/template.rs) ----------- *)
(* Special forms are recognised ONLY in head position of the template  *)
(* itself, or as elements of a sequence template. Nested occurrences   *)
(* are copied verbatim.                                                *)
(*                                                                     *)
(*   (literal <expr>)                                                  *)
(*   (cond (<test> <body>) ... (else <body>))                          *)
(*   <sequence>  = a list whose every element is a literal/cond form   *)
(*   otherwise   = plain substitution of parameter symbols             *)
(*                                                                     *)
(*   test = "(" "=" var value ")"                                      *)
(*        | "(" "member" var "(" value* ")" ")"                        *)
(*        | "(" "type?" var type-name ")"                              *)

(* -- Resource requirements ----------------------------------------- *)
(* System limits: 1..64 depth, 1..8192 expansion, 1..1000 ms.          *)
(* Defaults when omitted: 16 / 1024 / 50.                              *)

resource-clause = "(" , ":resource-requirements" , ws , resource-alist , ")" ;

resource-alist  = "(" , { ws , resource-pair } , ")" ;

resource-pair   = "(" , resource-key , ws , number , ")" ;

resource-key    = "max-depth"
                | "max-expansion-size"
                | "verification-time" ;

(* -- Integrity & metadata ------------------------------------------ *)

examples-clause = "(" , ":examples" , { ws , expression } , ")" ;

signature-clause= "(" , ( ":signature" | ":signed" ) , ws ,
                        ( string | symbol ) , ")" ;

hash-clause     = "(" , ":hash" , ws , ( string | symbol ) , ")" ;

(* NOTE: the KEYWORD form names the SIGNATURE ALGORITHM, e.g.          *)
(* (:protocol "ed25519"). It is unrelated to the SYMBOL-headed         *)
(* (protocol (then ...)) causal-protocol clause below. Dispatch is on  *)
(* whether the clause head is a keyword or a symbol.                   *)
sig-algorithm-clause
                = "(" , ":protocol" , ws , ( string | symbol ) , ")" ;

(* -- Role layer (SPEC-014, R6) -------------------------------------- *)

roles-clause    = "(" , ":roles" , ws , role-decl-list , ")" ;

role-decl-list  = "(" , role-decl , { ws , role-decl } , ")" ;

role-decl       = role-name                       (* singleton role *)
                | "(" , "*" , ws , role-name , ")" ;   (* indexed role *)

causal-locality-clause
                = "(" , ":causal-locality" , ws ,
                        ( "derive" | "reject" ) , ")" ;   (* default: reject *)


(* ================================================================== *)
(* Contracts (SPEC-002, R5)                                            *)
(* ================================================================== *)

(* -- Causal protocol ------------------------------------------------ *)
(* A DAG over performative types rooted at `begin`. (then a b c)       *)
(* desugars to the pairwise edges a->b, b->c.                          *)

protocol-clause = "(" , "protocol" , ( ws , then-clause ) ,
                        { ws , then-clause } , ")" ;

then-clause     = "(" , "then" , ( ws , protocol-step ) ,
                        ( ws , protocol-step ) ,
                        { ws , protocol-step } , ")" ;

protocol-step   = node-ref | repeat-form ;

(* any/all take TWO OR MORE members. *)
node-ref        = perf-name
                | "(" , "any" , ws , perf-name ,
                        ( ws , perf-name ) , { ws , perf-name } , ")"
                | "(" , "all" , ws , perf-name ,
                        ( ws , perf-name ) , { ws , perf-name } , ")" ;

(* Macro-expanded once, at parse, into k copies of the body. Copy i of
   step x is named "x#i"; '#' is outside symbol-char, so a synthesised
   name can never collide with a user-declared performative. *)
repeat-form     = "(" , "repeat" , ws , positive-number ,
                        ( ws , protocol-step ) ,
                        { ws , protocol-step } , ")" ;

positive-number = digit , { digit } ;      (* must be > 0 *)

(* -- Shape constraints ---------------------------------------------- *)
(* Checked against the EXPANDED message, non-recursively.              *)

shape-clause    = "(" , "shape" , ws , perf-name ,
                        ( ws , shape-rule ) , { ws , shape-rule } , ")" ;

shape-rule      = require-rule | optional-rule | depth-rule ;

require-rule    = "(" , "require" , ws , keyword , [ ws , type-expr ] ,
                        { ws , shape-rule } , ")" ;

optional-rule   = "(" , "optional" , ws , keyword , [ ws , type-expr ] ,
                        [ ws , default-value ] , { ws , shape-rule } , ")" ;

depth-rule      = "(" , "max-depth" , ws , number , ")" ;

type-decl       = "(" , "type" , ws , local-type-name , ws , type-expr , ")" ;
type-expr       = builtin-type | local-type-name
                | "(" , "one-of" , ws , scalar-literal , { ws , scalar-literal } , ")"
                | "(" , "string" , ws , string-rule , { ws , string-rule } , ")"
                | "(" , "list" , ws , length-rule , { ws , length-rule } , ")"
                | "(" , numeric-base , ws , numeric-bound , { ws , numeric-bound } , ")"
                | "(" , ( "and" | "or" ) , ws , type-expr , ws , type-expr , { ws , type-expr } , ")" ;
builtin-type    = "string" | "hlc" | "number" | "integer" | "float" | "decimal"
                | "nonnegative" | "bool" | "symbol" | "keyword" | "list" ;
local-type-name = symbol ; (* [a-z][a-z0-9-]{0,47}, excluding reserved names *)
scalar-literal  = string | boolean | keyword | numeric | symbol ; (* list values are excluded; symbols are literal here *)
numeric-base    = "number" | "integer" | "float" | "decimal" ;
comparator      = ">=" | ">" | "<=" | "<" ;
numeric-bound   = "(" , comparator , ws , numeric , ")" ;
string-rule     = matches-rule | length-rule ;
matches-rule    = "(" , "matches" , ws , string , ")" ; (* RFC 9485 I-Regexp *)
length-rule     = "(" , "length" , ws , length-bound , { ws , length-bound } , ")" ;
length-bound    = "(" , comparator , ws , number , ")" ; (* nonnegative i64 *)
default-value   = "(" , "default" , ws , expression , ")" ;


(* ================================================================== *)
(* State declarations: SPEC-019, SPEC-035 and SPEC-038                   *)
(* Author reference: docs/reference/state-language.md.                 *)
(* Reference: crates/cbcl-parser/src/state_parser.rs.                   *)
(* Grammar describes recognition; the installation checks described   *)
(* in the author reference additionally constrain names and types.     *)
(* ================================================================== *)

state-clause = "(" , "state" , ws , state-entry , { ws , state-entry } , ")" ;
state-entry = field-entry | domain-entry | threshold-entry | freeze-entry
            | lattice-entry ;
field-entry = "(" , state-name , ws , state-rule , ")" ;
state-name = symbol ; (* installation: [a-z][a-z0-9-]{0,47} *)
state-rule = ordinary-state-rule | context-rule | finite-lift-rule
           | bounded-counter-rule ;
ordinary-state-rule
    = "(" , "initial" , ws , perf-name , ws , keyword , ")"
    | "(" , ( "exists" | "count" | "progress" ) , ws , perf-name , ")"
    | "(" , ( "events" | "set-union" | "values" | "multi-value-register" ) ,
        ws , perf-name , ws , keyword , ")"
    | "(" , ( "values-per-key" | "multi-value-map" ) , ws , perf-name ,
        ws , keyword , ws , keyword , [ ws , perf-name ] , ")"
    | "(" , ( "lww-register" | "lww-per-signer" ) , ws , perf-name ,
        ws , keyword , ws , keyword , ")"
    | "(" , "lww-map" , ws , perf-name , ws , keyword , ws , keyword ,
        ws , keyword , [ ws , perf-name ] , ")"
    | "(" , ( "observed-set" | "counter" ) , ws , perf-name ,
        ws , perf-name , ws , keyword , ")"
    | "(" , ( "histogram" | "sum" ) , ws , state-name , ")" ;
domain-entry = "(" , "domain" , ws , perf-name , ws , keyword , ws , state-name , ")" ;
threshold-entry = "(" , "threshold" , ws , state-name , ws , state-name ,
    ws , threshold-element , { ws , threshold-element } , ")"
    | "(" , "threshold" , ws , state-name , ws , threshold-condition , ")" ;
threshold-condition = "(" , "read" , ws , state-name , ws , threshold-element , ")"
    | "(" , "and" , ws , threshold-condition , ws , threshold-condition ,
        { ws , threshold-condition } , ")" ;
threshold-element = scalar
    | "(" , ( "count" | "sum" | "progress" ) , ws , number , ")"
    | "(" , "member" , ws , scalar , ")" ;
scalar = string | number | boolean ;
(* `fault` is a terminal outcome, never a threshold alternative. *)
freeze-entry = "(" , "freeze" , ws , state-name , ws , perf-name ,
    [ ws , ( "supersede" | "fault" ) ] , ")" ;

context-rule = "(" , "context" , [ ws , context-path ] , ")" ;
context-path = "dialect" , [ ws , dialect-path ]
             | "thread" , [ ws , thread-path ]
             | "observation" , [ ws , ( "accepted-count" | "frontier" ) ] ;
dialect-path = "address" | "body-address" | "name" | "author"
             | "roles" , [ ws , role-name ]
             | "bounds" , [ ws , state-bound-name ] ;
thread-path = "id" | "root" | "initiator" | "opener"
            | "roles" , [ ws , role-name ] ;
(* Nested role paths must name roles declared by this dialect. *)

lattice-entry = "(" , "lattice" , ws , state-name ,
    ws , "(" , "elements" , ws , state-name , { ws , state-name } , ")" ,
    ws , "(" , "bottom" , ws , state-name , ")" ,
    ws , "(" , "top" , ws , state-name , ")" ,
    ws , "(" , "join" , { ws , join-row } , ")" , ")" ;
join-row = "(" , state-name , ws , state-name , ws , state-name , ")" ;
finite-lift-rule = "(" , "lift" , ws , perf-name ,
    ws , "(" , "into" , ws , state-name , ")" ,
    ws , "(" , "contribute" , ws , contribution-row ,
        { ws , contribution-row } , ")" , [ ws , projection ] , ")" ;
contribution-row = "(" , keyword , ws , scalar , ws , state-name , ")" ;
projection = "(" , "project" , [ ws , "stable" ] ,
    ws , "(" , projection-row , { ws , projection-row } , ")" , ")" ;
projection-row = "(" , state-name , ws , scalar , ")" ;
state-bounds-clause = "(" , ":state-bounds" , { ws , state-bound } , ")" ;
state-bound = "(" , state-bound-name , ws , positive-number , ")" ;
state-bound-name = "max-string" | "max-list" | "max-number" | "max-fields" ;

(* Resource options may appear in any order. Unknown and duplicate     *)
(* options reject. Account mode requires floor, initial-rights, issuers,*)
(* increment, decrement and transfer. Collective mode uses initial,    *)
(* requires quorum-budget, and forbids account allocations/transfers.  *)
(* Account ceiling and initial-headroom must occur together.           *)
bounded-counter-rule = "(" , "bounded-counter" , { ws , counter-option } , ")" ;
counter-option = floor-option | ceiling-option | rights-option | headroom-option
    | issuer-option | increment-option | decrement-option | transfer-option
    | transfer-headroom-option | ownership-option | scalar-initial-option
    | certification-option ;
floor-option = "(" , "floor" , ws , number , ")" ;
ceiling-option = "(" , "ceiling" , ws , number , ")" ;
rights-option = "(" , "initial-rights" , ws , perf-name , ws , keyword , ")" ;
headroom-option = "(" , "initial-headroom" , ws , perf-name , ws , keyword , ")" ;
issuer-option = "(" , "issuers" , ws , ( role-name | "(" , ")" ) , ")" ;
increment-option = "(" , "increment" , ws , perf-name , ws , keyword , ")" ;
decrement-option = "(" , "decrement" , ws , perf-name , ws , keyword , ")" ;
transfer-option = "(" , "transfer" , ws , perf-name , ws , keyword , ws , keyword , ")" ;
transfer-headroom-option = "(" , "transfer-headroom" , ws , perf-name , ws , keyword , ws , keyword , ")" ;
ownership-option = "(" , "ownership" , ws , ( "account" | "collective" ) , ")" ;
scalar-initial-option = "(" , "initial" , ws , perf-name , ws , keyword , ")" ;
certification-option = "(" , "certification" , ws ,
    ( "host-gate" | "quorum-budget" , { ws , certification-setting } ) , ")" ;
certification-setting = "(" , "validators" , ws , symbol , { ws , symbol } , ")"
    | "(" , "faults" , ws , number , ")" ;
(* quorum-budget requires both settings; faults is nonnegative u32.    *)
(* Transfer keywords are recipient then amount. Escrow data references use
   f1220<64 lowercase hex>, the canonical state/native multihash spelling.
   Initial allocation/headroom values are nonempty lists of distinct
   (account natural-integer) pairs, checked before resource interpretation. *)
