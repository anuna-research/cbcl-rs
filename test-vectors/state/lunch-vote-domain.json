{
  "contract": "(define lunch-vote (cbcl) @anuna\n  (:resource-requirements\n    ((max-depth 12)\n     (max-expansion-size 2048)\n     (verification-time 200)))\n\n  (:state-bounds\n    (max-string 280)\n    (max-list 24))\n\n  (extend propose (to question options)\n    (tell to :question question :options options))\n\n  (extend vote (to choice clock)\n    (tell to :choice choice :clock clock))\n\n  (shape propose\n    (require :question string)\n    (require :options list))\n\n  (shape vote\n    (require :choice string)\n    (require :clock hlc))\n\n  (protocol\n    (then begin propose)\n    (then propose vote))\n\n  (state\n    (question (initial propose :question))\n    (options  (initial propose :options))\n    (domain vote :choice options)\n    (ballots  (lww-per-signer vote :choice :clock))\n    (tally    (histogram ballots))))",
