[
  {
    "id": "sexpr-parse-001",
    "description": "Simple octet-string: 3:abc",
    "input": "3:abc",
    "expected": {
      "type": "success",
      "value": {
        "kind": "octet-string",
        "bytes": [97, 98, 99]
      }
    },
    "source": "tests/test-csexp.scm:verbatim-encoding",
    "spec_ref": "RFC 9804 Section 4.1"
  },
  {
    "id": "sexpr-parse-002",
    "description": "Zero-length octet-string: 0:",
    "input": "0:",
    "expected": {
      "type": "success",
      "value": {
        "kind": "octet-string",
        "bytes": []
      }
    },
    "source": "tests/test-csexp.scm:verbatim-encoding",
    "spec_ref": "RFC 9804 Section 4.1"
  },
  {
    "id": "sexpr-parse-003",
