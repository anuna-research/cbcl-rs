(always r-native (assessment ?p ?f native ?s) (documented-support ?p ?f))
(meta r-native (source "cbcl-comparison-method#assessment-ratings") (description "Only explicit native assessments establish support; unknown is never absence"))
(always r-scope (finding bounded-search) (finding universal-uniqueness-unestablished))
(meta r-scope (source "cbcl-comparison-method#claim-policy") (description "A bounded comparison cannot establish absence of every other equivalent system"))
