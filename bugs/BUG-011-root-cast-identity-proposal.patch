+// REVIEW PROPOSAL ONLY: changes existing role-root addresses.
+// Commit the outermost sealed nomination for causal roots, retaining ordinary
+// business-act and role-free addresses. Authentication remains host-supplied.
+fn state_identity_message<'a>(message: &'a Message, simple: &'a Message) -> &'a Message {
+    if !matches!(simple.caused_by(), None | Some(CausedBy::Begin)) {
+        return simple;
+    }
+    let mut current = message;
+    loop {
+        match current {
+            Message::Wrapped { wrapper: crate::message::WrapperType::WithRoles, .. } => return current,
+            Message::Wrapped { content, .. } => current = content,
+            Message::Dialect { inner, .. } => current = inner,
+            _ => return simple,
+        }
