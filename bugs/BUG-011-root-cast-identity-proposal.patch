+#[test]
+fn sealed_cast_root_identity_commits_roster() {
+    let src = source(None);
+    let d = parse_dialect(&parse(&src).unwrap()).unwrap();
+    let first = root_act("");
+    let second = act(r#"(with-roles ((chair @chair) (reviewer @x @y @z)) (signed @chair (hello :thread "t" :caused-by begin)))"#, "@chair");
+    assert_ne!(first.address, second.address, "sealed root identity must commit its cast");
+    let thread = cbcl_core::store::ThreadId("t".into());
+    let a = state_exports::admit(&d, &thread, &[], &first);
+    let b = state_exports::admit(&d, &thread, &[], &second);
+    assert!(matches!(a, state_exports::Admission::Accepted), "first={a:?}");
+    assert!(matches!(b, state_exports::Admission::Accepted), "second={b:?}");
+    let a = read(&src, &[first]);
+    let b = read(&src, &[second]);
+    assert_ne!(a["reviewers"], b["reviewers"], "distinct roots retain distinct rosters");
+}
