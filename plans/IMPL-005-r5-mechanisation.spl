;; ----------------------------------------------------------------------
;; Priority — gate the headline theorem path before R5 / DCFL
;; ----------------------------------------------------------------------

;; The SPEC-005 headline theorem is verify_eventually_consistent (REQ-514).
;; Run lattice + verify chain ahead of R5 sub-checks and DCFL preservation
;; so the central proof exists before time is spent on the perimeter.
(prefer r-assign-result-lattice r-assign-dcfl-preservation)
(prefer r-assign-store-lattice r-assign-dcfl-preservation)
(prefer r-assign-verify-monotone r-assign-r5-acyclicity)
(prefer r-assign-verify-monotone r-assign-r5-reachability)
(prefer r-assign-verify-monotone r-assign-r5-perf-definedness)
(prefer r-assign-verify-monotone r-assign-r5-step-uniqueness)
(prefer r-assign-verify-fanin-meet r-assign-r5-acyclicity)
(prefer r-assign-verify-eventual-consistency r-assign-r5-acyclicity)

;; Among R5 sub-checks: easiest first, hardest last (matches ADR-512 risk profile).
(prefer r-assign-r5-perf-definedness r-assign-r5-step-uniqueness)
(prefer r-assign-r5-step-uniqueness r-assign-r5-reachability)
(prefer r-assign-r5-reachability r-assign-r5-acyclicity)

;; verified-by-init runs early to expose the current gap map; do it before R5.
(prefer r-assign-verified-by-init r-assign-r5-acyclicity)

;; ----------------------------------------------------------------------
;; Rule metadata — the load-bearing reasons
;; ----------------------------------------------------------------------

(meta r-ready-verify-skeleton
  (description "verify model gates every verify theorem")
  (justification "REQ-512/513/514 quantify over `verify`; the Lean definition has to exist before any of the three theorems can even be stated. Mirror the Rust source at a recorded SHA so the parity-tests task has a fixed reference point."))

(meta r-ready-verify-eventual-consistency
  (description "Eventual consistency follows from monotonicity + fan-in homomorphism")
  (justification "SPEC-005 REQ-514 and TEST-514 explicitly note the proof is direct from REQ-512 + REQ-513. Sequencing this way avoids re-proving the lattice case analysis a second time."))

(meta r-ready-parity-tests
  (description "Parity tests gate at the end, not per-theorem")
  (justification "ADR-513 frames parity tests as a single deliverable that catches Rust↔Lean drift; bundling them avoids per-PR test scaffolding churn and keeps the REQ → test → theorem mapping in one file."))

(meta r-ready-ci-build
  (description "CI step needs both the parity tests and the axiom audit to be meaningful")
  (justification "NFR-510 + NFR-511 + REQ-518 all converge on a single CI gate. Wiring CI before parity tests + axiom audit exist would either skip them or fail spuriously."))

(meta r-ready-verified-by-final
  (description "Closeout reconciles intent (init pass) with reality (what landed)")
  (justification "Per RISK-514: distinguishing `verified-by: lean` from `verified-by: lean (soundness only)` is the key honesty signal of this plan. Has to come last so the annotations reflect the as-built state."))

(meta r-assign-verify-skeleton
  (description "verify model needs careful Rust-mirror discipline")
  (justification "Records the Rust source path + SHA in the module header per task acceptance — this is the anchor that NFR-512 (proof and code in same PR) checks against."))
