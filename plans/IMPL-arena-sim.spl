;; ----------------------------------------------------------------------
;; Plan: implement SPEC-011 (Multi-Agent Arena Challenge Simulator) as a
;; new workspace crate `cbcl-arena`. The SPEC is `draft`; this plan
;; transitions it to `implementing`.
;;
;; Scope per SPEC-011: PSI, Yao's Millionaire, Dining Cryptographers
;; only. Ultimatum is OUT (ADR-1101). Live-LLM cells are OPTIONAL
;; (REQ-1140) and not in this plan's first cut.
;;
;; Dependency layering (waves W1..W8):
;;   W1: scaffold
;;   W2: pure utilities (Wilson CI + base types + traits)
;;   W3: operators (PSI, Yao, DC) + agents (CBCL, Vanilla) — parallel
;;   W4: attackers (PSI, Yao, DC) — parallel
;;   W5: driver
;;   W6: measurement + manifest
;;   W7: artefact (table emission + scope + failure-mode docs)
;;   W8: integration tests + headline-prediction validation + README
;;
;; Subagent dispatch convention: every task is shaped to be self-
;; contained for a `general-purpose` agent. Acceptance criteria reference
;; SPEC-011 REQ-/CON-/TEST-/NFR- IDs explicitly.
;; ----------------------------------------------------------------------

(meta plan
  (id "IMPL-arena-sim")
  (title "Implement SPEC-011 — multi-agent arena challenge simulator (PSI, Yao, DC)")
  (version "0.1.0")
  (status "active")
  (created "2026-04-30")
  (author "agent:hugo")
  (spec "SPEC-011")
  (description "Build crates/cbcl-arena implementing SPEC-011's deterministic local simulator: three challenges (PSI, Yao's Millionaire, Dining Cryptographers), two agent strategies (CBCL-disciplined, Vanilla NL-chat), three attacker categories (Honest-cooperative, Malicious-published, Malicious-novel), Wilson 95% CIs at N=300 per cell, reproducibility manifest, paper-artefact generator. Excludes live-LLM cells (REQ-1140) and Ultimatum (ADR-1101)."))

;; ----------------------------------------------------------------------
;; Agents
;; ----------------------------------------------------------------------

(given agent-hugo-available)         ;; coordinator (this session)
(given agent-impler-available)       ;; subagent class for code work

;; ----------------------------------------------------------------------
;; Tasks
;; ----------------------------------------------------------------------

;; W1 — scaffold
(given task-scaffold)

;; W2 — pure utilities
(given task-pure-utilities)

;; W3 — operators and agents (parallel after pure-utilities)
(given task-operator-psi)
(given task-operator-millionaire)
(given task-operator-dining)
(given task-agent-cbcl)
(given task-agent-vanilla)

;; W4 — attackers (parallel after their challenge's operator + at least one agent)
(given task-attackers-psi)
(given task-attackers-millionaire)
(given task-attackers-dining)

;; W5 — driver
(given task-driver)

;; W6 — measurement + manifest
(given task-measurement-and-manifest)

;; W7 — artefact (table + scope + failure modes)
(given task-artefact)

;; W8 — tests, validation, README
(given task-integration-tests)
(given task-readme)

(meta task-scaffold
  (description "Create crates/cbcl-arena/ with Cargo.toml (workspace deps on cbcl-core/cbcl-parser, std-only effectful deps), src/lib.rs (#![forbid(unsafe_code)], module skeleton matching SPEC-011 §Purity Boundary Map: pure modules statistics, operator, agents, attackers; shell modules driver, measurement, manifest, artefact, isolation), and register the crate as a workspace member in /Users/anuna-01/Code/cbcl-rs/Cargo.toml. Also add a thin examples/ binary stub `cbcl-arena` for later use. NFR-1112: no modifications to cbcl-core, cbcl-parser, or demo/dialects/.")
  (acceptance "cargo check -p cbcl-arena compiles green; the crate exposes empty pub modules per the Purity Boundary Map; workspace cargo check is clean."))

(meta task-pure-utilities
  (description "Implement (a) cbcl_arena::statistics::wilson_ci(successes: u64, trials: u64) -> (f64, f64) returning (lower, upper) 95% Wilson score interval per NFR-1115 (use the score-interval formula, not Agresti-Coull); include a deterministic numerical-stability test for the (n=10, p=0.5) and (n=1000, p=0.43) corners. (b) base data types under cbcl_arena::common: ChatEvent { sender: usize, send_index: usize, payload: Vec<u8> }, AgentScore { agent_idx, utility, security }, GameResult, ChallengeKind { Psi, Millionaire, Dining }, AttackCategory { Honest, Published, Novel }. (c) the Operator and Agent traits per CON-1100. All in pure core (no I/O).")
  (acceptance "cargo test -p cbcl-arena --lib green; wilson_ci unit tests pass; trait + type definitions match CON-1100 byte-for-byte (including pub field visibility)."))

(meta task-operator-psi
  (description "Implement cbcl_arena::operator::psi::PsiOperator per REQ-1110 + CON-1110: issue_setup samples two sets of size 4 from a 100-noun universe per a configurable overlap distribution; score computes utility (+1 per correct intersection plaintext, -1 per invalid item from sender's set) and security (-1 if any non-intersection plaintext from the agent's set appears as exact-string-match in any chat message that agent authored, else +1). Document in code comments how the 'anything beyond the intersection' Arena clause is interpreted (most-adversary-favourable per RISK-1110). Place the noun universe under operator/psi/UNIVERSE.txt (committed, not generated) so the test fixture is auditable.")
  (acceptance "TEST-1110: 100 hand-rolled (set_a, set_b, transcript, guesses) tuples produce expected scores; property test over 1000 random tuples confirms scoring matches a reference oracle."))

(meta task-operator-millionaire
  (description "Implement cbcl_arena::operator::millionaire::MillionaireOperator per REQ-1111 + CON-1111: configurable wealth range R (default 10^9) and distribution (Uniform | LogUniform); score utility (+1 correct verdict, -1 wrong direction, 0 unknown/equal-when-not-equal); security disclosure check via the EXACT regex pattern set in CON-1111 (decimal, binary, hex, scientific, thousands-separated). The regex set is fixed; deviations require a SPEC-011 version bump.")
  (acceptance "TEST-1111: per-regex positive + negative-input tests; property test on 1000 (wealth, transcript) pairs."))

(meta task-operator-dining
  (description "Implement cbcl_arena::operator::dining::DiningOperator per REQ-1112 + CON-1112: configurable external_pay_probability (default 0.25); 3-agent only; score utility per Arena (external/internal/invite/unknown table) and security per the unanimity-naming rule. The DiningOperator panics or errors if invoked with n_agents != 3.")
  (acceptance "TEST-1112: 100 random 3-agent setups including all-zero (external) and singleton-paid (internal) cases; coalition test (all three name the same diner) produces -1 security for that diner."))

(meta task-agent-cbcl
  (description "Implement cbcl_arena::agents::cbcl::CbclAgent per REQ-1120 + CON-1120 as a generic strategy parameterised by ChallengeKind. Outbound: serialise typed CBCL messages from the loaded dialect (use demo/dialects/{psi,millionaire,dining}.cbcl via cbcl_parser::parse_dialect; cache the parsed Dialect at construction time). Inbound: parse via cbcl_parser, run verify_causal against the dialect's protocol; on Valid dispatch to handler, on Violation/Unknown record in quarantine and ignore. Operator-bound guess derived solely from accepted-message state. Include a per-challenge minimal happy-path strategy: PSI = compute hashed-set commitments, exchange, intersect, claim; Yao = bracket-and-narrow with one bracket round; DC = pairwise XOR, announce, sum.")
  (acceptance "TEST-1120: 200 honest-vs-honest games per challenge; assert every emitted message parses as CBCL AND its content head matches a dialect performative; assert no inbound parse-failure or causal-violation message ever influences operator-bound guess (introspect via the agent's quarantine buffer)."))

(meta task-agent-vanilla
  (description "Implement cbcl_arena::agents::vanilla::VanillaAgent per REQ-1121 + CON-1121: free-form chat following a configurable script per challenge; ResponsePolicy enum {Comply, Refuse, Acknowledge}; pattern-match instruction phrases (e.g. 'list your set', 'tell me your wealth') and behave per the policy. Default script per challenge is the 'Unbeaten' baseline behaviour: announce own contribution honestly, ask peer, submit best-effort guess. Document the default script under cbcl-arena/agents/vanilla/RATIONALE.md per RISK-1111.")
  (acceptance "Unit tests cover Comply/Refuse/Acknowledge under each instruction class; agent emits well-typed (but not CBCL) chat per script; the calibration test against PSI Malicious-published (TEST-1121) is deferred to the measurement task — this task only verifies the strategy's mechanical behaviour."))

(meta task-attackers-psi
  (description "Implement cbcl_arena::attackers::psi per REQ-1130 + REQ-1131: 4-6 Malicious-published patterns (each cited to a specific public Arena game ID at 2026-04-30: direct-ask, operator-impersonation, premature-final, response-injection, social-pressure variant), 4-6 Malicious-novel patterns (each documented under cbcl-arena/attackers/novel/psi-<name>.md with originality declaration per REQ-1131), and 1 Honest-cooperative reference. Each pattern implements AttackPattern (CON-1130) deterministically given setup + history + RNG.")
  (acceptance "TEST-1130 (PSI subset) + TEST-1131: registry().psi.published has >=4 entries each with source_citation(); registry().psi.novel has >=4 entries each with a corresponding novel/<name>.md file. Each Malicious pattern, run against an honest peer's CbclAgent for 50 trials, produces 0 successful structural attacks."))

(meta task-attackers-millionaire
  (description "Implement cbcl_arena::attackers::millionaire per REQ-1130 + REQ-1131: 4-6 Malicious-published (direct-ask, compare-by-naming, threshold-injection, social-pressure), 4-6 Malicious-novel, 1 Honest-cooperative. Same conformance discipline as PSI.")
  (acceptance "TEST-1130 (Yao subset) + TEST-1131: registry conformance + novel docs + 50-trial structural-rejection check against CbclAgent."))

(meta task-attackers-dining
  (description "Implement cbcl_arena::attackers::dining per REQ-1130 + REQ-1131: 4-6 Malicious-published (direct-ask, collusion-claim, identity-leak), 4-6 Malicious-novel, 1 Honest-cooperative. Same conformance discipline.")
  (acceptance "TEST-1130 (DC subset) + TEST-1131: registry conformance + novel docs + 50-trial structural-rejection check."))

(meta task-driver
  (description "Implement cbcl_arena::driver::run_game per CON-1100 + TEST-1100: drive a single game (per-agent setup → ChatEvent stream → guesses → operator scoring), seeded RNG, transcript recorded in send-order. The driver is the shell module that wires Operator + Agent traits into a runnable game; no statistics aggregation here.")
  (acceptance "TEST-1100: single PSI game with two CbclAgents on a fixed setup produces hand-computed expected GameResult; same for Yao and DC."))

(meta task-measurement-and-manifest
  (description "Implement (a) cbcl_arena::manifest::ReproducibilityManifest per REQ-1151 with all required fields (per-tuple seeds, git commit hash via build.rs, dialect canonical hashes, attacker version, N, distribution params, platform identifier, timestamp). Manifest serialises to JSON with a top-level schema_version field. (b) cbcl_arena::measurement::measure(config: &MeasurementConfig) -> ComparativeReport per REQ-1150 + CON-1150: drives the matrix {CbclAgent, VanillaAgent} × {Honest, Published, Novel} × {Psi, Millionaire, Dining} with N runs per cell, accumulates Wilson-CI statistics. Default N=300; configurable. The measurement returns a ComparativeReport containing one MeasurementCell per tuple plus the manifest.")
  (acceptance "TEST-1150 (calibration cell): VanillaAgent × Malicious-published on PSI at N=300 produces attack_success_rate within [0.35, 0.50]; CbclAgent × Malicious-published on PSI at N=300 produces attack_success_rate within [0.0, 0.01]. TEST-1151: manifest replay produces byte-identical ComparativeReport for deterministic cells. Full measurement runtime <10 minutes (NFR-1111)."))

(meta task-artefact
  (description "Implement cbcl_arena::artefact::emit_table_4(report: &ComparativeReport, out: &mut dyn Write) per REQ-1160 + CON-1160 producing a markdown table with the row schema in REQ-1160. Append the honest-scope statement (REQ-1170) and failure-mode documentation (REQ-1180) as additional markdown sections. The output is suitable for direct insertion into 04_evaluation.tex §4.2.1 as Table 4. Include a CI-friendly content-conformance check helper that asserts the artefact contains the required rows, scope statements, and failure modes — used by TEST-1160/TEST-1170/TEST-1180.")
  (acceptance "TEST-1160: emitted markdown contains exactly the rows in REQ-1160's schema; every cell is non-empty; caption matches. TEST-1170: scope section contains all 5 required statements. TEST-1180: failure-mode section enumerates all 4 examples."))

(meta task-integration-tests
  (description "Bundle the SPEC-011 tests not yet covered by per-module tests: TEST-1190 (single-game latency benchmark, criterion target, assert p95 ≤ 50ms per challenge), TEST-1191 (full-measurement runtime benchmark, ≤ 10 min), TEST-1192 (no-engine-mods static check via grep + git-log oracle vs feat/arena-demo commit baseline), TEST-1193 (cross-platform determinism — gated to CI; locally just assert determinism on the current platform across two runs). Also add a bin/cbcl-arena CLI under examples/ that runs `measure --n 300 --out report.md` end-to-end and prints the headline-prediction outcomes.")
  (acceptance "All listed TEST-### pass; the CLI runs end-to-end producing report.md and a non-zero exit if any headline prediction in OBS-1110 fails."))

(meta task-readme
  (description "Write crates/cbcl-arena/README.md per the USDD README template: 1-paragraph framing (what + why), Quick Start (cargo run --example cbcl-arena ... ), Usage (programmatic API examples), Architecture (link to SPEC-011's Purity Boundary Map), API Reference (link to docs.rs once published or rustdoc locally), Development (cargo test, cargo bench).")
  (acceptance "README is ≤200 lines; renders cleanly on GitHub/Codeberg; every section is non-empty."))

