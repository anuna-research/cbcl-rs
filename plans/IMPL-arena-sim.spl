(normally r-ready-agent-vanilla
  (and task-agent-vanilla completed-pure-utilities)
  ready-agent-vanilla)

;; W4 — each attacker family needs its operator + at least one agent
(normally r-ready-attackers-psi
  (and task-attackers-psi
       completed-operator-psi
       completed-agent-cbcl)
  ready-attackers-psi)
(normally r-ready-attackers-millionaire
  (and task-attackers-millionaire
       completed-operator-millionaire
       completed-agent-cbcl)
  ready-attackers-millionaire)
(normally r-ready-attackers-dining
  (and task-attackers-dining
       completed-operator-dining
       completed-agent-cbcl)
  ready-attackers-dining)

;; W5 — driver needs all operators + both agents (it's the integration point)
(normally r-ready-driver
  (and task-driver
       completed-operator-psi
       completed-operator-millionaire
       completed-operator-dining
       completed-agent-cbcl
       completed-agent-vanilla)
  ready-driver)

;; W6 — measurement needs driver + all attackers
(normally r-ready-measurement
  (and task-measurement-and-manifest
       completed-driver
       completed-attackers-psi
       completed-attackers-millionaire
       completed-attackers-dining)
  ready-measurement-and-manifest)

;; W7 — artefact needs measurement (it consumes ComparativeReport)
(normally r-ready-artefact
  (and task-artefact completed-measurement-and-manifest)
  ready-artefact)

;; W8 — tests + README need artefact (the full pipeline must exist first)
(normally r-ready-integration
  (and task-integration-tests completed-artefact)
  ready-integration-tests)
(normally r-ready-readme
  (and task-readme completed-artefact)
  ready-readme)

