(meta r-ready-lexical (source "SPEC-018-dcfl-installation#REQ-1803"))
(given (task review))
(given (task-description review "Independently verify theorem and claim boundaries"))
(given (task-acceptance review "TEST-1804 through TEST-1806: axiom audit, mutation, runtime diff, independent review"))
