(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task machine))
(given (task-description machine "Build finite real-time DPDA certificate over finite alphabets with final-state acceptance"))
(given (task-acceptance machine "TEST-1800: finite carriers enforced by types, universal word semantics and axiom audit"))
(given (no-deps machine))
(normally r-ready-machine (and (task machine) (no-deps machine)) (ready machine))
(meta r-ready-machine (source "SPEC-018-dcfl-installation#REQ-1800"))
(given (task recursive))
