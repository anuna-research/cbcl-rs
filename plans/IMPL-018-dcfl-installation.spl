(given (task-acceptance recursive "TEST-1801: universal iff, malformed-word rejection, recursive scope and argument examples"))
(normally r-ready-recursive (and (task recursive) (completed machine)) (ready recursive))
(meta r-ready-recursive (source "SPEC-018-dcfl-installation#REQ-1801"))
(given (task installation))
