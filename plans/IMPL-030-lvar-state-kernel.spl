;; IMPL-030: the state kernel as a store of lattice variables (SPEC-038 v0.2.0).
;; Maintainer accepted ADR-3805 on 2026-11-08: stable thresholds, revisable
;; snapshots, separate terminal faults, and full domain carrier evidence.
;; Earlier lattice-algebra completion is reopened for v0.2.0 acceptance.
;; Slice 1 lands the pure lattice algebra and the factorisation tests with no
;; wire change; later slices add threshold reads, freeze, the conflict top,
;; bindings, and the Lean capstone. Acceptance criteria quote SPEC-038 TESTs.

(meta plan
  (id "IMPL-030")
  (title "LVar state kernel (SPEC-038 v0.2.0): author-facing stable facts, snapshots and conflicts")
  (version "0.2.0")
  (status "active")
  (created "2026-11-07")
  (author "agent:claude")
  (spec "SPEC-038, depends on SPEC-019, SPEC-036, SPEC-037")
  (description "Deliver crates/cbcl-core/src/lattice.rs (CON-3800) with differential and morphism tests (TEST-3800); then threshold observations (CON-3801, TEST-3801/3803), the conflict top (REQ-3804, TEST-3804), freeze (CON-3802, TEST-3802), snapshot marking (REQ-3805), the Lean lift theorem and quasi-determinism capstone (REQ-3806, TEST-3806), and docs/status."))

;; Task metadata

(meta task-lattice-algebra
  (description "CON-3800: crates/cbcl-core/src/lattice.rs with carriers, join, per-act contributions, factor(&Rule) for all installed heads, with explicit history carriers and native closure projections for progress and bounded-counter, evaluate and display matching state::fold; module rustdoc cites SPEC-038.")
  (acceptance "TEST-3800: crates/cbcl-parser/tests/lattice_factorisation.rs passes on every state vector: display equals fold in forward, reversed and duplicated delivery; L(A1 ∪ A2) = L(A1) ⊔ L(A2) for parity and halves partitions; the closure heads use history carriers and participate in the same partition union law."))

(meta task-threshold-reads
  (description "CON-3801 / ADR-3805: stable thresholds over count, members, nonnegative event sums and progress; reject signed net balances and fault alternatives; render successful, pending or separate terminal fault outcomes.")
  (acceptance "TEST-3801/3803/3804: properties and rejection tests pass; negative nonnegative-shaped inputs fail before admission; signed balances remain snapshots; conflicting initializers fault dependent lift/closure fields and thresholds; TEST-3807 conflict-free vectors unchanged."))

(meta task-semantic-alignment
  (description "ADR-3805: preserve raw initializer/contribution evidence under domain-carrier union; propagate initializer faults to dependent displays and thresholds; install nonnegative events sum thresholds without reinterpreting signed counters.")
  (acceptance "TEST-3800 distinct-opener admitted-history union law, TEST-3801 threshold stability or explicit fault, TEST-3803 signed source and fault alternative rejection, TEST-3804 derived and closure dependency faults; fresh-context review and isolated semantic mutants pass."))

;; Current Elephant task convention. This amendment is also in theory spec-038.
(given (task semantic-alignment))
(given (task-description semantic-alignment "Implement maintainer-approved ADR-3805 read semantics and repair domain carrier evidence."))
(given (task-acceptance semantic-alignment "TEST-3800/3801/3803/3804 pass, including admitted opener forks, negative-source rejection, derived and closure fault propagation, and semantic mutations."))
(given (no-deps semantic-alignment))
(normally r-ready-semantic-alignment (and (task semantic-alignment) (no-deps semantic-alignment)) (ready semantic-alignment))
(meta r-ready-semantic-alignment (source "SPEC-038-lvar-state-kernel#ADR-3805"))

(meta task-conflict-top
  (description "ADR-3803 / REQ-3804: add the sole carrier's top to the fold rendering of initial as {status: fault, evidence: [...]}, uniform with the resource fault; keep Absent for no opener.")
  (acceptance "TEST-3804 for initial and bounded-counter passes; vectors without conflicts are byte-identical (TEST-3807)."))

(meta task-freeze
  (description "CON-3802 / ADR-3802: parse (freeze field verb [policy]); fold excludes contributions causally after the freeze under supersede or joins to top under fault; render frozen with the freezing address; install checks field and verb.")
  (acceptance "TEST-3802 passes for both policies including the concurrent-write case; TEST-3804's freeze clause passes."))

(meta task-user-lattices
  (description "CON-3803 / REQ-3810: parse (lattice …) declarations and (lift … (into name) (contribute …) [(project [stable] …)]) rules; verify join totality, commutativity, associativity, idempotence, bottom identity and top absorption, contribution range, and monotonicity of stable projections at install; evaluate as a lift in lattice.rs; render project tables.")
  (acceptance "TEST-3808 passes including every rejection with its named witness; a field over an accepted user lattice passes TEST-3800; vectors unchanged (TEST-3807)."))

(meta task-snapshot-marking
  (description "REQ-3805: state_schema marks fields that are neither threshold nor frozen as snapshot; bindings' READMEs state the host obligation for effects.")
  (acceptance "TEST-3805 passes; js, wasm, erl and ffi docs updated."))

(meta task-lean-lift-theorem
  (description "Lean: define the carrier lattices and the lift; prove one theorem that any lifted term is a join-homomorphism, and derive the per-rule invariance of State.lean for the thirteen lift heads from it.")
  (acceptance "lake build green; scripts/check-axioms.sh allowlisted; the thirteen fold_perm_invariant conjuncts follow from the lift theorem without sorry."))

(meta task-lean-quasi-determinism
  (description "REQ-3806 / TEST-3806: state and prove quasi-determinism over StateKernelDelivery's replica model with top as the conflict case; show strong_eventual_consistency as the no-top specialisation.")
  (acceptance "lake build green; axiom audit clean; a semantic mutant that drops top-stickiness fails the proof."))

(meta task-docs-status
  (description "Update docs/concepts/bounded-counter.md and hlc-registers.md with the term reading of each head and the snapshot/threshold/frozen vocabulary; set SPEC-038 status to implemented; zetl check clean.")
  (acceptance "zetl check --dead-links --fail-on error clean; SPEC-038 status implemented with verified-by annotations reconciled to what landed; docs and rustdoc use the SPEC-038 Vocabulary (lift, display, LVar, put, threshold, frozen, snapshot, stable) with fold retained only as the API name."))

