;; W1 has no upstream task deps
(normally r-ready-trait-llm-backend
  task-trait-llm-backend
  ready-trait-llm-backend)
(normally r-ready-trait-protocol-adapter
  task-trait-protocol-adapter
  ready-trait-protocol-adapter)

;; W2 — adapters need both traits in place
(normally r-ready-adapter-psi
  (and task-adapter-psi
       completed-trait-llm-backend
       completed-trait-protocol-adapter)
  ready-adapter-psi)
(normally r-ready-adapter-yao
  (and task-adapter-yao
       completed-trait-llm-backend
       completed-trait-protocol-adapter)
  ready-adapter-yao)
(normally r-ready-adapter-auction
  (and task-adapter-auction
       completed-trait-llm-backend
       completed-trait-protocol-adapter)
  ready-adapter-auction)
(normally r-ready-adapter-dining
  (and task-adapter-dining
       completed-trait-llm-backend
       completed-trait-protocol-adapter)
  ready-adapter-dining)

;; W3 — backends need only LlmBackend trait
(normally r-ready-backend-claude
  (and task-backend-claude completed-trait-llm-backend)
  ready-backend-claude)
(normally r-ready-backend-gpt
  (and task-backend-gpt completed-trait-llm-backend)
  ready-backend-gpt)

;; W4 — live-cells matrix needs all adapters + at least one new backend
(normally r-ready-live-cells
  (and task-live-cells
       completed-adapter-psi
       completed-adapter-yao
       completed-adapter-auction
       completed-adapter-dining
       completed-backend-claude
       completed-backend-gpt)
  ready-live-cells)

;; W5 — vanilla sweep is independent of refactor
(normally r-ready-vanilla-sweep
  task-vanilla-sweep
  ready-vanilla-sweep)

;; W6 — PSI N-bump needs the PSI adapter (so the run is on the new harness)
(normally r-ready-psi-n100
  (and task-psi-n100 completed-adapter-psi)
  ready-psi-n100)

;; W7 — ultimatum: operator first, then agent + vanilla in parallel,
;; then attackers, then matrix wiring
(normally r-ready-ultimatum-operator
  task-ultimatum-operator
  ready-ultimatum-operator)
(normally r-ready-ultimatum-cbcl-agent
  (and task-ultimatum-cbcl-agent completed-ultimatum-operator)
  ready-ultimatum-cbcl-agent)
(normally r-ready-ultimatum-vanilla
  (and task-ultimatum-vanilla completed-ultimatum-operator)
  ready-ultimatum-vanilla)
(normally r-ready-ultimatum-attackers
  (and task-ultimatum-attackers
       completed-ultimatum-operator
       completed-ultimatum-cbcl-agent)
  ready-ultimatum-attackers)
(normally r-ready-ultimatum-measurement
  (and task-ultimatum-measurement
       completed-ultimatum-operator
       completed-ultimatum-cbcl-agent
       completed-ultimatum-vanilla
       completed-ultimatum-attackers)
  ready-ultimatum-measurement)

;; W8 — adaptive attacker is independent
(normally r-ready-adaptive-attacker
  task-adaptive-attacker
  ready-adaptive-attacker)

;; W9 — DC coalition is independent
(normally r-ready-dc-coalition
  task-dc-coalition
  ready-dc-coalition)

;; W10 — paper integration needs all measurement-producing tasks
(normally r-ready-paper
  (and task-paper
       completed-live-cells
       completed-vanilla-sweep
       completed-psi-n100
       completed-ultimatum-measurement
       completed-adaptive-attacker
       completed-dc-coalition)
  ready-paper)

