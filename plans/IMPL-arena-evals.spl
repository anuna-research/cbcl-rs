;; ----------------------------------------------------------------------
;; Task metadata
;; ----------------------------------------------------------------------

(meta task-trait-llm-backend
  (description "Introduce `LlmBackend` trait in crates/cbcl-arena/src/glm.rs (or new src/llm/mod.rs). Surface: `fn chat(&self, req: &ChatRequest) -> Result<(ChatResponse, serde_json::Value), String>`. Existing `GlmClient` becomes `GlmBackend: LlmBackend`. The trait should be object-safe (the seats hold `Box<dyn LlmBackend>` so we don't proliferate generics). Move ENDPOINT/MODEL/CURL_BIN constants behind the impl. Keep ChatRequest/ChatResponse/ChatMessage/ToolDef/ToolCall types provider-neutral; document the OpenAI-compat assumption.")
  (acceptance "`cargo build -p cbcl-arena` passes; existing glm_psi example still runs against ZAI_API_KEY (smoke-tested via `--smoke`); GlmBackend is exposed via `cbcl_arena::llm::GlmBackend`; LlmBackend trait is object-safe (compile-time check via a `Box<dyn LlmBackend>` in a doctest)."))

(meta task-trait-protocol-adapter
  (description "Introduce `ProtocolAdapter` trait that captures per-operator dialect plumbing. Surface (sketch): `system_prompt(&self, setup: &Setup) -> String`; `tools(&self) -> Vec<ToolDef>`; `dispatch_tool(&mut self, tc: &ToolCall, ctx: &mut SeatCtx) -> ToolDispatch` (returns Emit { wire_payload, tool_ack } | Hash { ack } | NoOp { ack }); `parse_inbound(&self, payload: &str) -> Option<StructuredInbound>`; `is_done(&self) -> bool`; `final_guess(&self) -> Guess`. Refactor `GlmDisciplinedSeat` into a generic `DisciplinedSeat<A: ProtocolAdapter, B: LlmBackend>` whose only state is { backend, transcript_path, trial, turn, max_turns, history, adapter }. PSI's existing salt/commit/reveal/claim/finalize phase machine + canonical-hashing + caused-by-resolution + leaf-rebuild lives behind `PsiProtocolAdapter`. Same refactor for `GlmCbclNativeSeat` -> `CbclNativeSeat<A, B>` (the native seat asks the LLM to emit raw s-expressions; the adapter only parses-and-validates and resolves `latest`).")
  (acceptance "DisciplinedSeat<PsiProtocolAdapter, GlmBackend> compiles and reproduces glm51-disciplined-NNN.jsonl byte-for-byte against a fixed trial seed (modulo timestamp differences in the transcript header); same for native; existing example glm_psi.rs continues to pass --smoke."))

(meta task-adapter-psi
  (description "Extract `PsiProtocolAdapter` from the current `GlmDisciplinedSeat`/`GlmCbclNativeSeat` PSI logic. All PSI-specific code (DISCIPLINED_SYSTEM_TEMPLATE, NATIVE_SYSTEM_TEMPLATE, parse_psi_message, extract_reveal_hashes, protocol_hash, canonical_hash_of, caused_by_for, rebuild_leaves, the six PSI tool defs) moves into src/llm/adapters/psi.rs. The seat is now generic; this task is the parallel-extraction half of `task-trait-protocol-adapter`.")
  (acceptance "`cargo test -p cbcl-arena --lib` passes; a smoke run of glm_psi --smoke produces semantically equivalent transcripts to before the refactor; PsiProtocolAdapter is the only PSI-aware code outside src/operator/psi.rs."))

(meta task-adapter-yao
  (description "Author `MillionaireProtocolAdapter` in src/llm/adapters/millionaire.rs. Yao's-Millionaire dialect is documented in demo/dialects/millionaire.cbcl — read the performative set there and mirror it in the adapter. System prompt explains the >/< game; tools should expose the dialect's performatives (likely yao-commit, yao-cipher, yao-reveal, yao-final or similar) plus a hash_element-style cryptographic helper if needed. Inbound parser handles all peer performatives. Phase machine matches the dialect's (then ...) chain. Document hash function choice in the rustdoc.")
  (acceptance "Smoke test: a YaoCbclStrategy peer plays one game against a DisciplinedSeat<MillionaireProtocolAdapter, GlmBackend> on a fixed trial seed and produces a winner; quarantine never fires under honest play; transcript JSONL is valid; cargo test -p cbcl-arena --lib millionaire passes."))

(meta task-adapter-auction
  (description "Author `AuctionProtocolAdapter` in src/llm/adapters/auction.rs. Sealed-bid auction (SPEC-004 / demo/dialects/auction.cbcl): three performatives commit / reveal / declare-winner. System template explains the auction game (bid, commit-then-reveal, winner-takes-all). Tool defs match the three performatives plus a hash helper for SHA-256(:hash) commitments. Inbound parser handles peer commits / reveals / declarations. Phase machine matches (then begin commit reveal declare-winner). Auctioneer-vs-bidder roles surface as a SeatRole field on the adapter (lowest agent_idx is auctioneer per the existing AuctionCbclStrategy convention).")
  (acceptance "Smoke test: a DisciplinedSeat<AuctionProtocolAdapter, GlmBackend> auctioneer + AuctionCbclStrategy bidders complete a 3-bidder game; highest-bidder wins; security +1 across the board; cargo test -p cbcl-arena --lib auction passes."))

(meta task-adapter-dining
  (description "Author `DiningProtocolAdapter` in src/llm/adapters/dining.rs. DC dialect (demo/dialects/dining.cbcl): performative set + (then ...) chain match the existing DiningCbclStrategy. System prompt explains the cryptographers' dinner (paid bit, pairwise random bits, parity announcement). Tool defs expose dialect performatives plus a parity helper if pairwise-secret hashing is needed. Phase machine + parser straightforward.")
  (acceptance "DisciplinedSeat<DiningProtocolAdapter, GlmBackend> + DiningCbclStrategy peers complete an honest 3-diner game; verdict matches deterministic baseline; cargo test -p cbcl-arena --lib dining passes."))

(meta task-backend-claude
  (description "Add `ClaudeBackend` impl of `LlmBackend` in src/llm/backends/claude.rs. Targets Anthropic's Messages API at https://api.anthropic.com/v1/messages, model `claude-sonnet-4-6`. Auth via ANTHROPIC_API_KEY. Translation layer: ChatMessage system->system field (Anthropic separates system from messages); user/assistant->messages array; tool_calls<->Anthropic content-blocks; tool_call_id<->tool_use_id. Use `/usr/bin/curl` to keep with NFR-1112 (no new deps). Reasoning-mode / extended-thinking flag off by default. Retry-once-on-5xx mirroring GlmBackend. Add prompt caching on the system prompt + tool defs (per Anthropic best practice — see `claude-api` skill).")
  (acceptance "Unit test: ClaudeBackend.chat() against a recorded fixture round-trips correctly; smoke test (gated on ANTHROPIC_API_KEY env var) executes one PSI disciplined trial and produces a non-empty transcript; cargo build -p cbcl-arena passes."))

(meta task-backend-gpt
  (description "Add `OpenAIBackend` impl of `LlmBackend` in src/llm/backends/openai.rs. Targets OpenAI's chat-completions API at https://api.openai.com/v1/chat/completions, model `gpt-4.1`. Auth via OPENAI_API_KEY. The OpenAI schema is the inverse-source of our existing ChatRequest/ChatResponse types so the translation layer is near-identity; the differences are: (a) `max_completion_tokens` not `max_tokens` for newer models; (b) tool_calls are nested similarly. Retry-once mirror GlmBackend.")
  (acceptance "Unit test: OpenAIBackend.chat() against a recorded fixture round-trips; smoke test (gated on OPENAI_API_KEY) executes one PSI disciplined trial; cargo build -p cbcl-arena passes."))

(meta task-live-cells
  (description "Author `examples/live_arena.rs` (or extend examples/glm_psi.rs into a generic harness). CLI surface: `--challenge psi|millionaire|auction|dining` × `--backend glm|claude|gpt` × `--cell free|disciplined|native|cooperative|attacker` × `--n N`. Wires the (challenge, backend, cell) triple to (ProtocolAdapter, LlmBackend, SeatVariant). Emits transcripts under crates/cbcl-arena/transcripts/<backend>-<challenge>-<cell>-NNN.jsonl. Run the matrix at N=20 smoke followed by N=100+ release for the headline cells (PSI disciplined × {glm, claude, gpt}; Yao disciplined × {glm, claude, gpt}; Auction disciplined × {glm, claude, gpt}; Dining disciplined × {glm}). Emit a summary markdown table at the end (Wilson 95 percent CIs).")
  (acceptance "`cargo run --release --example live_arena -- --challenge psi --backend glm --cell disciplined --n 20` produces transcripts and a summary table reproducing existing PSI numbers within Wilson-CI overlap; the same command with --challenge millionaire / auction / dining produces non-empty transcripts and a summary; one full matrix run is committed to the repo as transcripts/."))

(meta task-vanilla-sweep
  (description "Add a `regex_breadth: VanillaBreadth { Strict, Default, Permissive, Loose }` knob to VanillaAgent in src/agents/vanilla.rs. Each variant maps to a distinct set of regex patterns of increasing breadth (Strict: literal-only; Default: current behaviour; Permissive: word-boundary loosening; Loose: substring match with case-insensitive flag). Surface a `--vanilla-sweep` flag in the live_arena example (or a new example sweep_vanilla.rs) that runs N trials per breadth × challenge × attacker and reports a *range column* of attack-success rates. Emit results to a JSON file under crates/cbcl-arena/results/vanilla-sweep-NNN.json.")
  (acceptance "Sweep across {Strict, Default, Permissive, Loose} × PSI × Malicious-published produces a 4-row distribution; the range column (min-max attack-success rate) is non-degenerate; the existing VanillaAgent::default() corresponds to `Default` breadth so prior measurements are unchanged; cargo test -p cbcl-arena --lib vanilla passes; results JSON committed."))

(meta task-psi-n100
  (description "Run the PSI live-LLM disciplined-cell at N=128 (next power of 2 above 100, divisible by both 4 and 8 to balance attacker rotation) on the GLM backend. Reuse existing transcripts where deterministic seeds match (no rerun cost). Emit Wilson 95 CIs for both 03-G-A and 03-G-B cells; verify the direction is now CI-separated (or report the new overlap if it isn't). Update measurement.rs's per-tuple-seed table to admit N=128 deterministically.")
  (acceptance "transcripts/glm51-disciplined-{020..127}.jsonl exist; the summary table reports separated Wilson CIs (or, if not separated, an explicit note in the eval-update doc that the magnitude direction remains uncertain); cargo run --release --example live_arena -- --challenge psi --cell disciplined --n 128 exits 0; total wall-time recorded for budget tracking."))

(meta task-ultimatum-operator
  (description "Implement crates/cbcl-arena/src/operator/ultimatum.rs. UltimatumOperator { proposer_idx: usize, responder_idx: usize, pie_size: u64, seed: u64 }. issue_setup samples per-agent role (proposer vs responder) and per-agent reservation values. score: per-agent utility (proposer's payoff = pie - offer if accepted else 0; responder's payoff = offer if accepted else 0); per-agent security (-1 if a manipulation succeeded — e.g., proposer received responder's reservation value via leak, or responder accepted a sub-reservation offer due to coercion attack). Add ChallengeKind::Ultimatum to common.rs. Reads demo/dialects/ultimatum.cbcl (already shipped) for protocol structure.")
  (acceptance "TEST-equivalent: hand-rolled (roles, offer, accept-flag) tuples produce expected scores; honest-baseline run yields utility = subgame-perfect-equilibrium offer; cargo test -p cbcl-arena --lib operator::ultimatum passes."))

(meta task-ultimatum-cbcl-agent
  (description "Implement crates/cbcl-arena/src/agents/cbcl/ultimatum.rs as a per-challenge ChallengeStrategy for UltimatumOperator's setup/guess types. Strategy: proposer emits ultimatum-offer with offer >= responder-reservation-floor (uniformly drawn above floor); responder accepts iff offer >= own_reservation. Final guess: the agreed offer for the proposer; the accept/reject decision for the responder.")
  (acceptance "Honest CbclAgent vs CbclAgent ultimatum game on a fixed seed produces an accepted offer; quarantine never fires under honest play; cargo test -p cbcl-arena --lib agents::cbcl::ultimatum passes."))

(meta task-ultimatum-vanilla
  (description "Extend VanillaAgent with VanillaSetup::Ultimatum variant and a default script. Proposer script: at-start emit `i offer: {floor*1.5}` where floor is heuristically guessed; AfterPattern matching `(?i)\\b(reservation|threshold|minimum)\\b`: emit `mine is {own_reservation}` (this is the manipulation hook — vanilla agents leak their reservation when prompted). Responder script: AfterPattern matching `(?i)\\bi offer:?\\s*(\\d+)`: emit `accepted` or `rejected` based on captured offer vs own reservation.")
  (acceptance "Vanilla-vs-vanilla converges on an offer; vanilla-vs-reservation-extraction-attacker produces a non-zero rate of vanilla agents leaking their reservation; cargo test -p cbcl-arena --lib agents::vanilla passes."))

(meta task-ultimatum-attackers
  (description "Implement crates/cbcl-arena/src/attackers/ultimatum.rs with: 1 Honest-cooperative reference. 3 Malicious-published patterns (reservation-extraction, ultimatum-coercion, fairness-pressure — each cited from the behavioural-game-theory literature with source_citation). 4 Malicious-novel patterns (forged-counter-offer, role-spoofing, premature-acceptance-claim, one author-designed). Each documented under crates/cbcl-arena/attackers/novel/ultimatum-<name>.md.")
  (acceptance "registry().ultimatum.published.len() >= 3; .novel.len() >= 4; .honest.len() >= 1; per-novel markdown files exist with originality declarations; 50 trials per Malicious pattern against an honest CbclAgent: every trial produces security +1 for the honest agent."))

(meta task-ultimatum-measurement
  (description "Extend MeasurementConfig + measurement.rs to include ChallengeKind::Ultimatum. Add UltimatumSeat enum mirroring PsiSeat / MillionaireSeat / DiningSeat. Run a calibration probe at N=300: Vanilla × reservation-extraction reproduces a published baseline (TBD: cite Camerer 2003 chapter on UG behavioural data); CBCL × Published × Ultimatum = 0; CBCL × Novel × Ultimatum = 0.")
  (acceptance "`cargo run --release --example cli -- --n 300 --challenges ultimatum` exits 0; the four predictions PASS; full-matrix run (psi+yao+dc+auction+ultimatum) completes within NFR-1111's 10-minute budget."))

(meta task-adaptive-attacker
  (description "Implement an `AdaptiveAttacker<P: AttackPattern>` wrapper in src/attackers/adaptive.rs that maintains a last-K success window over a base library of attackers and re-weights selection by a Beta(1+wins, 1+losses) Thompson-sampling bandit. Surface: `AdaptiveAttacker::new(base: Vec<Box<dyn PsiPattern>>, k: usize, seed: u64)`. The base library defaults to the existing Malicious-published set. Add `--adaptive` flag to the live_arena example. The wrapper's session state is per-trial — the bandit adapts within a single trial across multiple turns, OR across multiple trials within a sweep (configurable via `AdaptiveScope { Trial, Sweep }`).")
  (acceptance "Adaptive attacker against a CbclAgent produces security +1 across all 50 trials (CBCL still wins); adaptive attacker against a VanillaAgent produces a strictly higher attack-success rate than any single base attacker (the bandit converges on the most-effective base pattern); cargo test -p cbcl-arena --lib attackers::adaptive passes."))

(meta task-dc-coalition
  (description "Add a `CoalitionAttacker` to src/attackers/dining.rs that models two attackers privately exchanging a shared random bit BEFORE the game starts (this expands DC's threat model — currently single-attacker only). Implementation: a wrapper that constructs two coordinated SeatPairs and shares a pre-game RNG between them so their announced parities can be co-conditioned. Add a CoalitionScope { Pairwise, Triadic } enum. Document the threat-model expansion in src/attackers/dining/COALITION.md (originality declaration: this is a deliberate expansion beyond SPEC-011's stated single-attacker threat model). Wire into measurement.rs as a separate attack-category column (so Demo 3's DC row stops being a 0-row).")
  (acceptance "Coalition × Vanilla DC produces a non-zero attack-success rate (the unanimity rule no longer defeats two coordinated attackers); Coalition × CBCL produces 0 (the dialect-grammar's pairwise-bit-binding defeats the coalition — this is the load-bearing claim); cargo test -p cbcl-arena --lib attackers::dining::coalition passes."))

(meta task-paper
  (description "Update the paper artefact under paper/ (or wherever 04_evaluation.tex lives) with: (a) tab:mcp-attacks new columns for Sonnet 4.6 + GPT-4.1 backends across PSI / Yao / Auction; (b) Demo 3 N=128 update for PSI live-LLM CIs; (c) new Demo 5 (Ultimatum) block with calibration paragraph + Table N (4-row × 7-attack matrix); (d) Demo 3 vanilla-sweep range column replacing the single-tuned-vanilla cell; (e) DC coalition row in Demo 3 with expanded threat-model paragraph; (f) adaptive attacker honest-scope paragraph in Demo 3. Per the existing 04_evaluation.tex convention: NO internal IDs (REQ-/SPEC-/OBS-/NFR-/TEST-/CON-/TM-/ADR-).")
  (acceptance "All four eval-tightening claims (E1-E4) reflected in measured numbers in the paper; ultimatum demo block compiles; tab:mcp-attacks columns populated with non-stub values; grep for REQ-/SPEC-/etc. across .tex files returns zero matches."))

