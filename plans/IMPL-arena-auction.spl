;; W4 — needs operator + both agents + attackers
(normally r-ready-measurement
  (and task-measurement
       completed-operator
       completed-cbcl-agent
       completed-vanilla-agent
       completed-attackers)
  ready-measurement)

;; W5 — paper update needs measured numbers from the calibration run
(normally r-ready-paper
  (and task-paper completed-measurement)
  ready-paper)

;; W6 — spec update is the synthesis step
(normally r-ready-spec-update
  (and task-spec-update completed-paper)
  ready-spec-update)

