; IMPL-021: bounded counter implementation ledger. Local steward; independent review is a separate session, not a distinct P2P signer.
(predicate task-description ((id symbol) (text symbol)) (kind state))
(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task escrow-grammar))
(given (task-description escrow-grammar "Recognize bounded-counter grammar and installation contracts"))
(given (task-acceptance escrow-grammar "TEST-1962/1965: malformed grammar, roles and fields reject"))
(given (no-deps escrow-grammar))
(normally r-ready-escrow-grammar (and (task escrow-grammar) (no-deps escrow-grammar)) (ready escrow-grammar))
(meta r-ready-escrow-grammar (source "SPEC-019-state-rules#REQ-1941"))
(given (task escrow-runtime))
(given (task-description escrow-runtime "Implement resource DAG verifier, fold, binder, issuance and exports"))
(given (task-acceptance escrow-runtime "TEST-1960 through TEST-1967: arithmetic, budgets, replay, fork and host gate tests pass"))
(normally r-ready-escrow-runtime (and (task escrow-runtime) (completed escrow-grammar)) (ready escrow-runtime))
(meta r-ready-escrow-runtime (source "SPEC-019-state-rules#CON-1908"))
(given (task escrow-evidence))
(given (task-description escrow-evidence "Run conformance, deliberate budget mutation, model and independent review"))
(given (task-acceptance escrow-evidence "TEST-1960/1968: conservation evidence and reviewed claim boundaries"))
(normally r-ready-escrow-evidence (and (task escrow-evidence) (completed escrow-runtime)) (ready escrow-evidence))
(meta r-ready-escrow-evidence (source "SPEC-019-state-rules#REQ-1947"))

; Depth remains claimable by the CBCL maintainer; runtime completion does not close it.
(given (task escrow-merge-proof))
(given (task-description escrow-merge-proof "CBCL maintainer: prove compatible resource-DAG union and Rust model correspondence"))
(given (task-acceptance escrow-merge-proof "TEST-1960/1969 depth: Lean proves resource-history merge safety and the runtime relation"))
(normally r-ready-escrow-merge-proof (and (task escrow-merge-proof) (completed escrow-runtime)) (ready escrow-merge-proof))
(meta r-ready-escrow-merge-proof (source "SPEC-019-state-rules#TEST-1960"))
(given (task escrow-host-crash))
(given (task-description escrow-host-crash "CBCL maintainer: test production durable adapter at process crash boundaries"))
(given (task-acceptance escrow-host-crash "TEST-1967 depth: reservation publication and effect crashes recover without double spend or effect"))
(normally r-ready-escrow-host-crash (and (task escrow-host-crash) (completed escrow-runtime)) (ready escrow-host-crash))
(meta r-ready-escrow-host-crash (source "SPEC-019-state-rules#TEST-1967"))
