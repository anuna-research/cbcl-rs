;; ================================================================
;; Rule metadata
;; ================================================================

(meta r-ready-verification-result
  (description "VerificationResult depends on protocol types")
  (justification "Violation variant wraps CausalViolation which is defined in protocol types"))

(meta r-ready-protocol-parser
  (description "Protocol parser depends on protocol types being defined first")
  (justification "Parser returns CausalProtocol which must exist. Also integrates into dialect_parser.rs"))

(meta r-ready-protocol-validation
  (description "R5 validation depends on having a parsed protocol to validate")
  (justification "Validation methods operate on CausalProtocol struct"))

(meta r-ready-message-store
  (description "Store depends on hash index and caused-by extraction")
  (justification "Store uses HashIndex for O(1) lookup and CausedBy for DAG structure"))

(meta r-ready-causal-verify
  (description "Causal verification depends on result type, protocol types, and store")
  (justification "verify_causal reads protocol, queries store, returns VerificationResult"))

(meta r-ready-pipeline
  (description "Pipeline integration is the capstone -- depends on all verification components")
  (justification "run_pipeline chains parse -> validate -> R1-R5 -> expand -> causal -> shape. Also handles REQ-210 (teach) and DCFL preservation (REQ-209, REQ-308)"))

(meta r-ready-compaction
  (description "Compaction depends on message store and unknown policy")
  (justification "Compaction safety check requires knowing about pending messages (Buffer policy). Does NOT depend on reconciliation -- they are independent features"))

(meta r-ready-causal-closure
  (description "Causal closure transfer depends on store and verification")
  (justification "Extract needs DAG traversal (store), verify needs causal checking. Also covers REQ-212 verification tiers"))

