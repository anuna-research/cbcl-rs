; IMPL-035: Halo2 state checkpoints implementation ledger (SPEC-035). Lead steward asserts;
; Circus/claude attempts execute; a fresh-context session performs review and sets status.
(predicate task-description ((id symbol) (text symbol)) (kind state))
(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(predicate gate-green ((id symbol)) (kind evidence))
(predicate evidence-recorded ((id symbol)) (kind evidence))

(given (task spec-review))
(given (task-description spec-review "Comprehension gate and adversarial review of SPEC-035 with dispositions recorded"))
(given (task-acceptance spec-review "TEST-3510 core: docs/evidence record carries both reviews and every disposition"))
(given (no-deps spec-review))
(normally r-ready-spec-review (and (task spec-review) (no-deps spec-review)) (ready spec-review))
(meta r-ready-spec-review (source "SPEC-035-halo2-state-checkpoints#REQ-3511"))

(given (task workspace-gates))
(given (task-description workspace-gates "Integrate cbcl-state-proof into the workspace: make check green, mutants.toml untouched for the crate, mutation runner moved to scripts/, README crate list"))
(given (task-acceptance workspace-gates "TEST-3508: make check passes; cargo tree -i lists only the crate; scripts/state-proof-mutations.py kills every mutant"))
(normally r-ready-workspace-gates (and (task workspace-gates) (completed spec-review)) (ready workspace-gates))
(meta r-ready-workspace-gates (source "SPEC-035-halo2-state-checkpoints#REQ-3509"))

(given (task semantics-pin))
(given (task-description semantics-pin "SEMANTICS_VERSION constant, relation_domain(version), golden vector test-vectors/state-proof/signer-supersession.json, pin and version tests, README procedure"))
(given (task-acceptance semantics-pin "TEST-3505: golden vector matches; reorder and whitespace invariance; semantics_version_changes_profile_identity fails under a changed version"))
(normally r-ready-semantics-pin (and (task semantics-pin) (completed workspace-gates)) (ready semantics-pin))
(meta r-ready-semantics-pin (source "SPEC-035-halo2-state-checkpoints#REQ-3506"))

(given (task chain))
(given (task-description chain "Chain type with private fields, new/to_json/from_json, Profile::genesis, Chain::verify(verifier, start, expected_end), PartialEq on Proof and Chain"))
(given (task-acceptance chain "TEST-3504: positive genesis, non-genesis start, empty chain, expected end; gap, swap, foreign profile, corrupt link, end mismatch, 65 links rejected; link-continuity mutation killed"))
(normally r-ready-chain (and (task chain) (completed workspace-gates)) (ready chain))
(meta r-ready-chain (source "SPEC-035-halo2-state-checkpoints#REQ-3505"))

(given (task attested-candidates))
(given (task-description attested-candidates "candidate.rs: private Candidate, attested via attestation_header_for on innermost simple message and verify_attestation_v2, KeyId identity check against :from, unauthenticated constructor, accessors; migrate callers"))
(given (task-acceptance attested-candidates "TEST-3503: attested fixture candidates give the same profile identity as unauthenticated ones; wrong signature, tampered payload, missing :sender/:thread, mismatched :from rejected; compile_fail doctest for struct literal"))
(normally r-ready-attested-candidates (and (task attested-candidates) (completed semantics-pin) (completed chain)) (ready attested-candidates))
(meta r-ready-attested-candidates (source "SPEC-035-halo2-state-checkpoints#REQ-3504"))

(given (task package-grammar))
(given (task-description package-grammar "Recognition tests for CON-3502 cases, proptest roundtrip for Proof and Chain, Prover transcript-length fail-closed, fuzz target state_proof_package in fuzz/"))
(given (task-acceptance package-grammar "TEST-3507 core: every listed negative case rejected, trailing whitespace accepted, roundtrip property passes; fuzz target builds"))
(normally r-ready-package-grammar (and (task package-grammar) (completed attested-candidates)) (ready package-grammar))
(meta r-ready-package-grammar (source "SPEC-035-halo2-state-checkpoints#REQ-3508"))

(given (task cli-checkpoint))
(given (task-description cli-checkpoint "cbcl-cli feature state-proof with optional dependency; checkpoint compile/prove/verify/chain-verify per CON-3505; profile.json recogniser; exit codes; integration tests"))
(given (task-acceptance cli-checkpoint "TEST-3509: compile prints identity and addresses; prove then verify exit 0; wrong --after exits 1; unknown member exits 1; chain-verify prints final checkpoint; feature-less binary rejects the subcommand"))
(normally r-ready-cli-checkpoint (and (task cli-checkpoint) (completed attested-candidates)) (ready cli-checkpoint))
(meta r-ready-cli-checkpoint (source "SPEC-035-halo2-state-checkpoints#REQ-3510"))

(given (task docs-evidence))
(given (task-description docs-evidence "Crate README rewritten for implemented status and limits, docs/concepts/state-checkpoint.md, README crate list, evidence record filled with gate outputs, mutation run and NFR-3500 measurement with machine recorded"))
(given (task-acceptance docs-evidence "TEST-3510 core and TEST-3511: evidence file carries executed gate commands, mutation results and the measured example run"))
(normally r-ready-docs-evidence (and (task docs-evidence) (completed package-grammar) (completed cli-checkpoint)) (ready docs-evidence))
(meta r-ready-docs-evidence (source "SPEC-035-halo2-state-checkpoints#REQ-3511"))

(given (task independent-review))
(given (task-description independent-review "Fresh-context adversarial code review of the integration branch against SPEC-035, cross-model attempt recorded, findings dispositioned, repairs scoped to implicated requirements"))
(given (task-acceptance independent-review "TEST-3510 core: review record with findings and dispositions committed; no critical finding open"))
(normally r-ready-independent-review (and (task independent-review) (completed docs-evidence)) (ready independent-review))
(meta r-ready-independent-review (source "SPEC-035-halo2-state-checkpoints#REQ-3511"))

(given (task status-implemented))
(given (task-description status-implemented "Reviewing session sets SPEC-035 status to implemented and keeps human review and production authorisation open"))
(given (task-acceptance status-implemented "TEST-3510 prohibited-action: status commit authored by the reviewing session, not the producing session"))
(normally r-ready-status-implemented (and (task status-implemented) (completed independent-review)) (ready status-implemented))
(meta r-ready-status-implemented (source "SPEC-035-halo2-state-checkpoints#TEST-3510"))

; Completion of every task is derived from inspected verifier evidence and a committed evidence file.
(normally r-complete-spec-review (and (gate-green spec-review) (evidence-recorded spec-review)) (completed spec-review))
(meta r-complete-spec-review (source "SPEC-035-halo2-state-checkpoints#TEST-3510"))
(normally r-complete-workspace-gates (and (gate-green workspace-gates) (evidence-recorded workspace-gates)) (completed workspace-gates))
(meta r-complete-workspace-gates (source "SPEC-035-halo2-state-checkpoints#TEST-3508"))
(normally r-complete-semantics-pin (and (gate-green semantics-pin) (evidence-recorded semantics-pin)) (completed semantics-pin))
(meta r-complete-semantics-pin (source "SPEC-035-halo2-state-checkpoints#TEST-3505"))
(normally r-complete-chain (and (gate-green chain) (evidence-recorded chain)) (completed chain))
(meta r-complete-chain (source "SPEC-035-halo2-state-checkpoints#TEST-3504"))
(normally r-complete-attested-candidates (and (gate-green attested-candidates) (evidence-recorded attested-candidates)) (completed attested-candidates))
(meta r-complete-attested-candidates (source "SPEC-035-halo2-state-checkpoints#TEST-3503"))
(normally r-complete-package-grammar (and (gate-green package-grammar) (evidence-recorded package-grammar)) (completed package-grammar))
(meta r-complete-package-grammar (source "SPEC-035-halo2-state-checkpoints#TEST-3507"))
(normally r-complete-cli-checkpoint (and (gate-green cli-checkpoint) (evidence-recorded cli-checkpoint)) (completed cli-checkpoint))
(meta r-complete-cli-checkpoint (source "SPEC-035-halo2-state-checkpoints#TEST-3509"))
(normally r-complete-docs-evidence (and (gate-green docs-evidence) (evidence-recorded docs-evidence)) (completed docs-evidence))
(meta r-complete-docs-evidence (source "SPEC-035-halo2-state-checkpoints#TEST-3510"))
(normally r-complete-independent-review (and (gate-green independent-review) (evidence-recorded independent-review)) (completed independent-review))
(meta r-complete-independent-review (source "SPEC-035-halo2-state-checkpoints#TEST-3510"))
(normally r-complete-status-implemented (and (gate-green status-implemented) (evidence-recorded status-implemented)) (completed status-implemented))
(meta r-complete-status-implemented (source "SPEC-035-halo2-state-checkpoints#TEST-3510"))
