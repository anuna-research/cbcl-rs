(predicate task-description ((id symbol) (text symbol)) (kind state))
(predicate task-acceptance ((id symbol) (text symbol)) (kind state))
(given (task design))
(given (task-description design "Resolve each longevity audit issue into a design decision and evidence obligation"))
(given (task-acceptance design "SPEC-043 audit and IMPL-043 decision matrix cover crypto, identities, dependencies, determinism, resources, extension, archives and authority"))
(given (no-deps design))
(normally r-ready-design (and (task design) (no-deps design)) (ready design))
(meta r-ready-design (source "SPEC-043-explicit-cbcl-release#Longevity audit — implementation observations, 2026-11-10"))
(given (task multikey))
(given (task-description multikey "Implement bounded public Multikey recognition and explicit suite-typed identity conversion"))
(given (task-acceptance multikey "TEST-4308 standard golden vectors, malformed inputs, wrong codecs and preimage preservation pass"))
(normally r-ready-multikey (and (task multikey) (completed design)) (ready multikey))
(meta r-ready-multikey (source "SPEC-043-explicit-cbcl-release#REQ-4308"))
(given (task deterministic))
(given (task-description deterministic "Preserve canonical numeric and identity bytes and reject resource arithmetic overflow"))
(given (task-acceptance deterministic "TEST-4309 and TEST-4310 cover overflow refusals and canonical boundary vectors"))
(normally r-ready-deterministic (and (task deterministic) (completed design)) (ready deterministic))
(meta r-ready-deterministic (source "SPEC-043-explicit-cbcl-release#REQ-4309"))
(given (task review))
(given (task-description review "Independently challenge Multikey, compatibility boundaries and resource evidence"))
(given (task-acceptance review "Independent findings repaired; required targeted and integration checks pass"))
(normally r-ready-review (and (task review) (completed multikey) (completed deterministic)) (ready review))
(meta r-ready-review (source "SPEC-043-explicit-cbcl-release#TEST-4308"))

; Foundation evidence: IMPL-043-longevity#Validation. Edition runtime remains draft.
; Independent reviewers: longevity_design_review and edition_orientation_check.
(given (completed design))
(given (completed multikey))
(given (completed deterministic))
(given (verified review))
(given (completed review))
