(meta r-ready-envelopes
  (description "Envelopes require the R4 v2 attestation discipline")
  (justification "REQ-701: envelope verifiability presupposes signatures over the hash-naming attestation (ADR-700)"))
(meta r-ready-r4v2-attestation
  (description "Signing-discipline change gated on spec review")
  (justification "PROTO-001 principles 11-12: SPEC-015 was authored this session and must be adversarially reviewed before its deepest change is built"))

