;; Plan: Implement fixes for `lean-cbcl` review findings (2026-05-04)
;; Source: review delivered in conversation on branch
;;         cleanup/lean-cbcl-review-findings.

(meta plan
  (id "CBCL-LEAN-REVIEW-2026-05-04")
  (title "Implement lean-cbcl review fixes")
  (version "1.0.0")
  (status "active")
  (created "2026-05-04")
  (author "agent:claude")
  (description "Address 8 review findings (4 medium / 4 low) in lean-cbcl. Build must remain green and AxiomAudit allowlist must be unchanged after every task."))

;; ============================================================
;; Agents
;; ============================================================

(given agent-claude-available)

;; ============================================================
;; Tasks
;; ============================================================

(given task-simp-literal-cleanup)
(given task-heartbeat-scope-serializer)
(given task-heartbeat-scope-detunion)
(given task-heartbeat-scope-detparser)
(given task-partial-to-total-dialectparser)
(given task-pipeline-proof-refactor)
(given task-r5-fuel-bound-tighten)
(given task-axiomaudit-instnonempty-check)
(given task-archive-proof-gaps)
(given task-gitignore-dsstore)
(given task-final-build-and-axiom-audit)

;; ============================================================
;; Task metadata
;; ============================================================

(meta task-simp-literal-cleanup
  (description "Remove the 16 trivial @[simp] literal lemmas in DetParser.lean:394-410 (one_lt_200..ninetyNine_ne_zero). They pollute the global simp set with concrete-Nat facts. Either inline `by decide` at the call sites in `langDetParser_step_state_lt`/`langDetParser_step_state_ne_zero` (lines 414-424), or make them `private` and drop the @[simp] attribute.")
  (acceptance "Lemmas removed or de-@[simp]'d; lake build passes; downstream consumers (theorems below them in DetParser.lean and any depending file) still elaborate.")
  (file "lean-cbcl/LeanCbcl/DetParser.lean")
  (priority "medium"))

(meta task-heartbeat-scope-serializer
  (description "Scope the file-level `set_option maxHeartbeats 3200000` in Serializer.lean:196 to only the theorem(s) that need it (likely `roundtrip_safeSymbol` at line 333). Use `set_option maxHeartbeats 3200000 in theorem ...`. Trivial native_decide tests on lines 347-382 should not inherit the bumped heartbeats.")
  (acceptance "File-level set_option removed; bump scoped via `... in` to only the theorems that need it; lake build passes.")
  (file "lean-cbcl/LeanCbcl/Serializer.lean")
  (priority "medium"))

(meta task-heartbeat-scope-detunion
  (description "Scope the file-level `set_option maxHeartbeats 1600000` in DeterministicUnion.lean:1218 to only the theorem(s) that need it (likely `agentDetParser_agrees` at line 1220). Use `set_option ... in theorem ...`.")
  (acceptance "File-level set_option removed; bump scoped via `... in`; lake build passes.")
  (file "lean-cbcl/LeanCbcl/DeterministicUnion.lean")
  (priority "medium"))

(meta task-heartbeat-scope-detparser
  (description "Replace the bump/reset pair `set_option maxHeartbeats 800000`/`200000` at DetParser.lean:412/427 with `set_option maxHeartbeats 800000 in` scoped to the two theorems `langDetParser_step_state_lt`/`langDetParser_step_state_ne_zero`. Remove the reset.")
  (acceptance "Bump scoped via `... in`; reset line removed; lake build passes.")
  (file "lean-cbcl/LeanCbcl/DetParser.lean")
  (priority "medium"))

(meta task-partial-to-total-dialectparser
  (description "Make `parseDialectClauses` (DialectParser.lean:157) a total well-founded recursive function. The recursion shrinks `clauses` (rest is shorter; rest' is length-1 of rest). Remove `partial`, add `termination_by clauses.length` and a `decreasing_by` proof if needed.")
  (acceptance "`partial` removed; function compiles as total; downstream `parseDialect`/lake build passes.")
  (file "lean-cbcl/LeanCbcl/DialectParser.lean")
  (priority "medium"))

(meta task-pipeline-proof-refactor
  (description "Refactor Pipeline.lean:132-207 (`pipeline_success_implies_valid`). Extract a private helper that captures the repeated `simp [...]; have heq : msg' = msg := by cases h; rfl; exact ⟨sexpr, by simp, heq ▸ hmsg, heq ▸ hvalid⟩` pattern into a single named lemma. Target: ~50-line LOC reduction with identical theorem statement.")
  (acceptance "Theorem statement and downstream `pipeline_success_grammar` unchanged; private helper introduced; LOC of the proof body cut by ≥30%; lake build passes.")
  (file "lean-cbcl/LeanCbcl/Pipeline.lean")
  (priority "medium"))

(meta task-r5-fuel-bound-tighten
  (description "Tighten the fuel bound in R5.lean from `names.length * names.length + 1` to `names.length + 1` at lines 140 and 413, IF the proofs of `check_acyclicity_iff_no_cycle` (line 367) and the corresponding reachability proof go through with the tighter bound. Otherwise (if the loose bound is load-bearing) leave the code untouched and add a `-- Fuel bound is intentionally quadratic: …` comment justifying it.")
  (acceptance "Either: (a) bound tightened to linear and lake build passes, OR (b) bound unchanged and a one-line justification comment added explaining why the quadratic margin is needed. AxiomAudit unchanged.")
  (file "lean-cbcl/LeanCbcl/R5.lean")
  (priority "low"))

(meta task-axiomaudit-instnonempty-check
  (description "Check whether `CBCL.ContentHash.instNonempty` (declared in Lattice/Store.lean:109 and listed in AxiomAudit allowlist line 21) actually appears in the closure of any audited theorem. Run `lake env lean AxiomAudit.lean` and verify. If unused, EITHER (preferred) audit a theorem that should depend on it and add a `#print axioms` line, OR (acceptable) remove it from the allowlist comment in AxiomAudit.lean and explain why no audited theorem depends on the instance.")
  (acceptance "AxiomAudit.lean accurately reflects which custom axioms are exercised by the audited theorem closure; either the allowlist matches actual usage, or the comment justifies the gap.")
  (file "lean-cbcl/AxiomAudit.lean")
  (priority "low"))

(meta task-archive-proof-gaps
  (description "Move `lean-cbcl/proof-gaps.spl` (a stale plan whose three tasks are all `(given completed-…)`) into the project's plan-archive convention. Per repo convention, plans live under `plans/`; archived plans should follow the existing closed-plan pattern. Inspect `plans/` for a `closed/` or `archive/` subdirectory and move accordingly. If no such convention exists, delete the file.")
  (acceptance "proof-gaps.spl no longer present in lean-cbcl/; either archived under plans/ following existing convention, or deleted; commit message documents the choice.")
  (file "lean-cbcl/proof-gaps.spl")
  (priority "low"))

(meta task-gitignore-dsstore
  (description "Add `**/.DS_Store` to the repo-root `.gitignore` (which currently only covers `**/.lake/`). Run `git rm --cached` on the existing tracked .DS_Store files (none are currently tracked, but verify) and confirm the untracked ones disappear from `git status`.")
  (acceptance "`.gitignore` includes `**/.DS_Store`; `git status` shows no .DS_Store entries.")
  (file ".gitignore")
  (priority "low"))

(meta task-final-build-and-axiom-audit
  (description "After all task fixes land, run `lake build` to confirm green, then `lake env lean AxiomAudit.lean` to confirm the audited-axiom set is unchanged from the pre-fix baseline. Standard kernel + 5 custom (`ContentHash`, `contentHash`, `contentHash_injective`, `Message.causedBy`, optionally `instNonempty`) only.")
  (acceptance "Both commands exit 0; AxiomAudit output diff against the pre-fix baseline shows no unauthorized additions.")
  (file "lean-cbcl/")
  (priority "high"))

;; ============================================================
;; Dependencies
;; ============================================================

;; The two tasks that touch DetParser.lean must be sequential
;; (task-simp-literal-cleanup before task-heartbeat-scope-detparser
;; — the simp removal may shift line numbers).
(given dep-detparser-order)

(normally r-block-detparser-heartbeat
  (and task-heartbeat-scope-detparser dep-detparser-order)
  blocked-heartbeat-scope-detparser-on-simp)

;; The final audit task depends on all fix tasks completing.
(given dep-final-after-fixes)

(normally r-block-final-audit
  (and task-final-build-and-axiom-audit dep-final-after-fixes)
  blocked-final-on-fixes)

;; All other tasks are independent.
(given no-deps-simp-literal-cleanup)
(given no-deps-heartbeat-scope-serializer)
(given no-deps-heartbeat-scope-detunion)
(given no-deps-partial-to-total-dialectparser)
(given no-deps-pipeline-proof-refactor)
