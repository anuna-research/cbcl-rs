import LeanCbcl.ConsensusFree.Coverage

/-! SPEC-029: a separate multi-parent protocol. Version adoption is local and
carries ALL previous signatures. No checkpoint vote, winner selection or shared
balance is consulted by admission. Finite topological indices are proof names,
not a service that orders transactions. -/
namespace CBCL.ConsensusFree.MultiParent
open CBCL.ValidatorBudget CBCL.SealedCheckpoint
open CBCL.ConsensusFree (setAt two isum markedNat marked_cast)
variable {V T R f : Nat}
/-- A finite version identifier, with zero reserved for genesis. -/
abbrev Version (V : Nat) := Fin (V+1)

/-- A finite DAG encoded by strictly lower topological parent indices. -/
structure Graph (V : Nat) where
  /-- Strictly preceding parent indices for each node. -/
  lower : (v : Version V) → List (Fin v.val)

/-- Lift a node’s typed lower indices into the common version universe. -/
def Graph.parents (g : Graph V) (v : Version V) : List (Version V) :=
  (g.lower v).map (fun p => ⟨p.val, Nat.lt_trans p.isLt v.isLt⟩)

theorem parent_lt {g : Graph V} {u v : Version V} (h : u ∈ g.parents v) : u.val < v.val := by
  obtain ⟨p, _, hp⟩ := List.mem_map.mp h
  subst u; exact p.isLt

/-- Reflexive ancestry generated by actual parent edges, not by numeric ordering. -/
inductive Ancestor (g : Graph V) : Version V → Version V → Prop where
  | refl (v) : Ancestor g v v
  | step {u p v} : Ancestor g u p → p ∈ g.parents v → Ancestor g u v

theorem Ancestor.trans {g : Graph V} {a b c} (ab : Ancestor g a b)
    (bc : Ancestor g b c) : Ancestor g a c := by
  induction bc with
  | refl => exact ab
  | step _ edge ih => exact .step ih edge

theorem Ancestor.rank {g : Graph V} {u v} (h : Ancestor g u v) : u.val ≤ v.val := by
  induction h with
  | refl => exact Nat.le_refl _
  | step _ edge ih => have := parent_lt edge; omega

/-- Immutable candidate books indexed by unique transaction identifiers. -/
structure Manifest (T R : Nat) where
  /-- IDs whose debit obligations are carried. -/
  held : Fin T → Bool
  /-- Held IDs reclaimed with cancellation certificates. -/
  refunded : Fin T → Bool
  /-- IDs whose finalized credits are imported. -/
  credited : Fin T → Bool
  /-- Exact nonnegative books for each resource coordinate. -/
  allocation : Fin R → Nat
  /-- Result of the pinned authority verifier for this version. -/
  authorized : Bool

/-- Authorization booleans are outputs of the ideal authenticated-role verifier,
not fields supplied by an untrusted requester. Packet-level refinement remains
in CollectiveProtocol for the existing single-parent protocol. -/
structure Config (V T R f : Nat) where
  /-- Immutable candidate version graph. -/
  graph : Graph V
  /-- Distinct validators, partitioned into honest core and Byzantine remainder for proof. -/
  committee : Committee f
  /-- Immutable candidate manifests; candidates need not be valid. -/
  manifest : Version V → Manifest T R
  /-- Genesis capacity per resource coordinate. -/
  initial : Fin R → Nat
  /-- Fully bound version of each immutable transaction. -/
  opVersion : Fin T → Version V
  /-- Per-resource gross debit. -/
  cost : Fin T → Fin R → Nat
  /-- Per-resource gross credit. -/
  credit : Fin T → Fin R → Nat
  /-- Authenticated operation-policy verification result. -/
  authorized : Fin T → Bool
  /-- Authenticated original-actor cancellation verification result. -/
  cancelAuthorized : Fin T → Bool
  /-- No transaction both debits and credits one coordinate; required for funded refinement. -/
  disjoint : ∀ tx d, cost tx d = 0 ∨ credit tx d = 0

/-- Genesis has no obligations; every other version uses its manifest held set. -/
def held (c : Config V T R f) (v : Version V) (tx : Fin T) : Bool :=
  if v.val = 0 then false else (c.manifest v).held tx
/-- Genesis has no refunds; nonroot refunds require cancellation evidence. -/
def refunded (c : Config V T R f) (v : Version V) (tx : Fin T) : Bool :=
  if v.val = 0 then false else (c.manifest v).refunded tx
/-- Genesis has no imported credits; nonroot credits require finality evidence. -/
def credited (c : Config V T R f) (v : Version V) (tx : Fin T) : Bool :=
  if v.val = 0 then false else (c.manifest v).credited tx
/-- Independent per-resource allocation of an immutable version. -/
def allowance (c : Config V T R f) (v : Version V) (d : Fin R) : Nat :=
  if v.val = 0 then c.initial d else (c.manifest v).allocation d

/-- Recognize parent structure, inherited sets, chronological obligations and exact books. -/
def Static (c : Config V T R f) (v : Version V) : Prop :=
  v.val = 0 ∨ ((c.manifest v).authorized = true ∧
    c.graph.parents v ≠ [] ∧ (c.graph.parents v).Nodup ∧
    (∀ p ∈ c.graph.parents v, ∀ tx, held c p tx = true → held c v tx = true) ∧
    (∀ p ∈ c.graph.parents v, ∀ tx, refunded c p tx = true → refunded c v tx = true) ∧
    (∀ p ∈ c.graph.parents v, ∀ tx, credited c p tx = true → credited c v tx = true) ∧
    (∀ tx, refunded c v tx = true → held c v tx = true) ∧
    (∀ tx, held c v tx = true → (c.opVersion tx).val < v.val) ∧
    (∀ d, (allowance c v d : Int) = (c.initial d : Int) +
      isum (List.finRange T) (fun tx => if credited c v tx then (c.credit tx d : Int) else 0) -
      isum (List.finRange T) (fun tx => if held c v tx then (c.cost tx d : Int) else 0) +
      isum (List.finRange T) (fun tx => if refunded c v tx then (c.cost tx d : Int) else 0)))
instance : Decidable (Static c v) := inferInstanceAs (Decidable (_ ∨ _))

/-- Asynchronous model state with independent validator journals and verified metadata. -/
structure State (V T : Nat) where
  /-- Independently adopted local version per validator. -/
  active : Nat → Version V
  /-- Historical local lineage; never cleared. -/
  visited : Nat → Version V → Bool
  /-- Verified metadata cache, abstracting packet receipt. -/
  known : Version V → Bool
  /-- Immutable reservation journal. -/
  signatures : Fin T → Nat → Bool
  /-- Cancellation-backed local charge releases. -/
  released : Fin T → Nat → Bool
  /-- Immutable effects acknowledgements. -/
  effects : Fin T → Nat → Bool
  /-- Immutable cancellation fences. -/
  fences : Fin T → Nat → Bool

/-- Genesis active everywhere, with no signatures, releases or certificates. -/
def initial : State V T where
  active := fun _ => 0
  visited := fun _ v => decide (v.val = 0)
  known := fun v => decide (v.val = 0)
  signatures := fun _ _ => false
  released := fun _ _ => false
  effects := fun _ _ => false
  fences := fun _ _ => false

/-- Count distinct committee positions against the two-thirds certificate threshold. -/
def quorum (c : Config V T R f) (votes : Nat → Bool) : Bool :=
  decide (2*f+1 ≤ voteCount (c.committee.core ++ c.committee.others) votes)
/-- A reservation certificate, which does not itself finalize business effects. -/
def operationCert (c : Config V T R f) (s : State V T) (tx : Fin T) := quorum c (s.signatures tx)
/-- An effects certificate that finalizes exactly one immutable transaction ID. -/
def finalCert (c : Config V T R f) (s : State V T) (tx : Fin T) := quorum c (s.effects tx)
/-- A fence certificate excluding future finalization of the same transaction. -/
def cancelCert (c : Config V T R f) (s : State V T) (tx : Fin T) := quorum c (s.fences tx)

/-- Verify a manifest against known parent metadata and actual credit/refund certificates. -/
def Live (c : Config V T R f) (s : State V T) (v : Version V) : Prop :=
  Static c v ∧ (∀ p ∈ c.graph.parents v, s.known p = true) ∧
    (∀ tx, credited c v tx = true → finalCert c s tx = true) ∧
    (∀ tx, refunded c v tx = true → cancelCert c s tx = true)
instance : Decidable (Live c s v) := inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

/-- Append a reservation signature without clearing any journal. -/
def signed (s : State V T) (tx : Fin T) (w : Nat) : State V T :=
  {s with signatures := two s.signatures tx w true}
/-- Mark a local charge released while retaining its historical signature. -/
def released (s : State V T) (tx : Fin T) (w : Nat) : State V T :=
  {s with released := two s.released tx w true}
/-- Append an effects acknowledgement. -/
def emitted (s : State V T) (tx : Fin T) (w : Nat) : State V T :=
  {s with effects := two s.effects tx w true}
/-- Append a cancellation fence. -/
def fenced (s : State V T) (tx : Fin T) (w : Nat) : State V T :=
  {s with fences := two s.fences tx w true}
/-- Cache a validated immutable manifest; this does not select a global version. -/
def recorded (s : State V T) (v : Version V) : State V T :=
  {s with known := setAt s.known v true}
/-- Advance one local active version and retain all previously visited versions. -/
def adopted (s : State V T) (v : Version V) (w : Nat) : State V T :=
  {s with active := setAt s.active w v, visited := two s.visited w v true}

/-- Scaled unreleased charges from a validator’s own signatures in one version. -/
def charge (c : Config V T R f) (s : State V T) (v : Version V) (w : Nat) (d : Fin R) : Nat :=
  sumOn (List.finRange T) (fun tx =>
    if c.opVersion tx = v ∧ s.signatures tx w = true ∧ s.released tx w = false
    then (2*f+1) * c.cost tx d else 0)
/-- Require every historical signature ID, including released and zero-cost IDs, in the target. -/
def Fits (c : Config V T R f) (s : State V T) (v : Version V) (w : Nat) : Prop :=
  ∀ tx, s.signatures tx w = true → held c v tx = true
instance : Decidable (Fits c s v w) := by unfold Fits; infer_instance

/-- Honest signing checks authenticated authorization, local active version and local capacity. -/
def SignAllowed (c : Config V T R f) (s : State V T) (tx : Fin T) (w : Nat) : Prop :=
  w ∈ c.committee.core → c.authorized tx = true ∧ s.active w = c.opVersion tx ∧
    s.released tx w = false ∧
    ∀ d, charge c (signed s tx w) (c.opVersion tx) w d ≤ (f+1)*allowance c (c.opVersion tx) d
instance : Decidable (SignAllowed c s tx w) := inferInstanceAs (Decidable (_ → _ ∧ _ ∧ _ ∧ _))

/-- Honest adoption requires known metadata, direct parenthood and complete own history. -/
def AdoptAllowed (c : Config V T R f) (s : State V T) (v : Version V) (w : Nat) : Prop :=
  s.known v = true ∧ (w ∈ c.committee.core → s.active w ∈ c.graph.parents v ∧ Fits c s v w)
instance : Decidable (AdoptAllowed c s v w) := inferInstanceAs (Decidable (_ ∧ _))

/-- Receiving a certificate verifies its signatures; asynchronous delivery is
abstracted by nondeterministic certificate-guarded steps. Byzantine votes are
unrestricted. Honest effect/fence exclusion and owner cancellation are local. -/
inductive Step (c : Config V T R f) : State V T → State V T → Prop where
  | sign (s tx w) (allowed : SignAllowed c s tx w) : Step c s (signed s tx w)
  | release (s tx w) (certificate : cancelCert c s tx = true) : Step c s (released s tx w)
  | effect (s tx w) (allowed : w ∈ c.committee.core →
      operationCert c s tx = true ∧ s.fences tx w = false) : Step c s (emitted s tx w)
  | fence (s tx w) (allowed : w ∈ c.committee.core →
      c.cancelAuthorized tx = true ∧ s.effects tx w = false) : Step c s (fenced s tx w)
  | record (s v) (valid : Live c s v) : Step c s (recorded s v)
  | adopt (s v w) (allowed : AdoptAllowed c s v w) : Step c s (adopted s v w)
  | replay (s) : Step c s s

/-- Evidence is append-only across concrete steps. -/
structure Journals (s t : State V T) : Prop where
  signatures : ∀ tx w, s.signatures tx w = true → t.signatures tx w = true
  effects : ∀ tx w, s.effects tx w = true → t.effects tx w = true
  fences : ∀ tx w, s.fences tx w = true → t.fences tx w = true
  known : ∀ v, s.known v = true → t.known v = true

theorem two_mono (fn : α → β → Bool) [DecidableEq α] [DecidableEq β] (a b x y)
    (h : fn x y = true) : two fn a b true x y = true := by
  by_cases xa : x = a <;> by_cases yb : y = b <;> simp_all [two, setAt]

set_option linter.unusedSimpArgs false in
theorem step_journals {c : Config V T R f} {s t} (step : Step c s t) : Journals s t := by
  cases step <;> constructor <;> intros <;>
    first | apply two_mono; assumption | assumption | (simp_all [signed, released, emitted, fenced, recorded, adopted, setAt])

theorem quorum_mono (c : Config V T R f) (a b : Nat → Bool)
    (mono : ∀ w, a w = true → b w = true) (h : quorum c a = true) : quorum c b = true := by
  have h := of_decide_eq_true h
  apply decide_eq_true
  apply Nat.le_trans h
  apply sumOn_mono
  intro w _
  cases ha : a w <;> cases hb : b w <;> simp_all [voteCount]

/-- Reachable-state facts derived from local guards; global safety is not a guard. -/
structure Invariant (c : Config V T R f) (s : State V T) : Prop where
  known : ∀ v, s.known v = true → Static c v ∧
    (∀ tx, credited c v tx = true → finalCert c s tx = true) ∧
    (∀ tx, refunded c v tx = true → cancelCert c s tx = true)
  visited_known : ∀ w, w ∈ c.committee.core → ∀ v, s.visited w v = true → s.known v = true
  active_visited : ∀ w, w ∈ c.committee.core → s.visited w (s.active w) = true
  below : ∀ w, w ∈ c.committee.core → ∀ v, s.visited w v = true → Ancestor c.graph v (s.active w)
  comparable : ∀ w, w ∈ c.committee.core → ∀ u v, s.visited w u = true → s.visited w v = true →
    Ancestor c.graph u v ∨ Ancestor c.graph v u
  signed_visited : ∀ tx w, w ∈ c.committee.core → s.signatures tx w = true → s.visited w (c.opVersion tx) = true
  coverage : ∀ tx w, w ∈ c.committee.core → s.signatures tx w = true → ∀ v,
    s.visited w v = true → (c.opVersion tx).val < v.val → held c v tx = true
  discipline : ∀ tx w, w ∈ c.committee.core → ¬ (s.effects tx w = true ∧ s.fences tx w = true)
  effect_operation : ∀ tx w, w ∈ c.committee.core → s.effects tx w = true → operationCert c s tx = true
  release_cancel : ∀ tx w, w ∈ c.committee.core → s.released tx w = true → cancelCert c s tx = true
  capacity : ∀ v w, w ∈ c.committee.core → ∀ d, charge c s v w d ≤ (f+1)*allowance c v d
  signature_auth : ∀ tx w, w ∈ c.committee.core → s.signatures tx w = true → c.authorized tx = true

@[simp] theorem sum_zero (xs : List α) : sumOn xs (fun _ => 0) = 0 := by
  induction xs <;> simp_all [sumOn]

theorem initial_invariant (c : Config V T R f) : Invariant c initial := by
  constructor
  · intro v hv
    have root : v.val = 0 := of_decide_eq_true hv
    refine ⟨Or.inl root, ?_, ?_⟩ <;> intros <;> simp_all [credited, refunded]
  · intro w hw v hv; exact hv
  · intros; simp [initial]
  · intro w hw v hv
    have root : v = 0 := Fin.ext (of_decide_eq_true hv)
    subst v; exact .refl _
  · intro w hw u v hu hv
    have same : u = v := Fin.ext ((of_decide_eq_true hu).trans (of_decide_eq_true hv).symm)
    subst v; exact Or.inl (.refl _)
  · intros; contradiction
  · intros; contradiction
  · intros; simp [initial]
  · intros; contradiction
  · intros; contradiction
  · intro v w hw d
    simp [charge, initial, sum_zero]
  · intros; contradiction

private theorem step_known {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) : ∀ v, t.known v = true → Static c v ∧
    (∀ tx, credited c v tx = true → finalCert c t tx = true) ∧
    (∀ tx, refunded c v tx = true → cancelCert c t tx = true) := by
  have j := step_journals st
  have old : ∀ v, s.known v = true → Static c v ∧
      (∀ tx, credited c v tx = true → finalCert c t tx = true) ∧
      (∀ tx, refunded c v tx = true → cancelCert c t tx = true) := by
    intro v hv
    obtain ⟨a,b,d⟩ := h.known v hv
    exact ⟨a, fun tx ht => quorum_mono c _ _ (j.effects tx) (b tx ht),
      fun tx ht => quorum_mono c _ _ (j.fences tx) (d tx ht)⟩
  cases st with
  | record v valid =>
    intro u hu
    by_cases uv : u = v
    · subst u; exact ⟨valid.1, valid.2.2.1, valid.2.2.2⟩
    · exact old u (by simpa [recorded, setAt, uv] using hu)
  | sign => exact old
  | release => exact old
  | effect => exact old
  | fence => exact old
  | adopt => exact old
  | replay => exact old

private theorem step_capacity {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) : ∀ v w, w ∈ c.committee.core → ∀ d,
      charge c t v w d ≤ (f+1)*allowance c v d := by
  cases st with
  | sign tx w allowed =>
    intro v u hu d
    by_cases uw : u = w
    · subst u
      by_cases vv : v = c.opVersion tx
      · subst v; exact (allowed hu).2.2.2 d
      · apply Nat.le_trans _ (h.capacity v w hu d)
        apply sumOn_mono
        intro x _
        by_cases xt : x = tx
        · subst x; simp [signed, two, setAt, Ne.symm vv]
        · simp [signed, two, setAt, xt]
    · apply Nat.le_trans _ (h.capacity v u hu d)
      apply sumOn_mono
      intro x _
      by_cases xt : x = tx <;> simp_all [signed, two, setAt]
  | release tx w certificate =>
    intro v u hu d
    apply Nat.le_trans _ (h.capacity v u hu d)
    apply sumOn_mono
    intro x _
    by_cases xt : x = tx
    · subst x; by_cases uw : u = w <;> simp_all [released, two, setAt]
    · simp [released, two, setAt, xt]
  | effect => exact h.capacity
  | fence => exact h.capacity
  | record => exact h.capacity
  | adopt => exact h.capacity
  | replay => exact h.capacity

private theorem step_lineage {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) :
    (∀ w, w ∈ c.committee.core → ∀ v, t.visited w v = true → t.known v = true) ∧
    (∀ w, w ∈ c.committee.core → t.visited w (t.active w) = true) ∧
    (∀ w, w ∈ c.committee.core → ∀ v, t.visited w v = true → Ancestor c.graph v (t.active w)) ∧
    (∀ w, w ∈ c.committee.core → ∀ u v, t.visited w u = true → t.visited w v = true →
      Ancestor c.graph u v ∨ Ancestor c.graph v u) := by
  have j := step_journals st
  have oldKnown : ∀ w, w ∈ c.committee.core → ∀ v, s.visited w v = true → t.known v = true :=
    fun w hw v hv => j.known v (h.visited_known w hw v hv)
  cases st with
  | adopt v w allowed =>
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro u hu x hx
      by_cases uw : u = w
      · subst u
        by_cases xv : x = v
        · subst x; exact allowed.1
        · exact oldKnown w hu x (by simpa [adopted, two, setAt, xv] using hx)
      · exact oldKnown u hu x (by simpa [adopted, two, setAt, uw] using hx)
    · intro u hu
      by_cases uw : u = w
      · subst u; simp [adopted, two, setAt]
      · simpa [adopted, two, setAt, uw] using h.active_visited u hu
    · intro u hu x hx
      by_cases uw : u = w
      · subst u
        by_cases xv : x = v
        · subst x; simpa [adopted, setAt] using (Ancestor.refl (g := c.graph) v)
        · have prior := h.below w hu x (by simpa [adopted, two, setAt, xv] using hx)
          simpa [adopted, setAt] using Ancestor.step prior (allowed.2 hu).1
      · simpa [adopted, two, setAt, uw] using h.below u hu x (by simpa [adopted, two, setAt, uw] using hx)
    · intro u hu x y hx hy
      by_cases uw : u = w
      · subst u
        by_cases xv : x = v
        · subst x
          by_cases yv : y = v
          · subst y; exact Or.inl (.refl _)
          · exact Or.inr (.step (h.below w hu y (by simpa [adopted, two, setAt, yv] using hy)) (allowed.2 hu).1)
        · by_cases yv : y = v
          · subst y; exact Or.inl (.step (h.below w hu x (by simpa [adopted, two, setAt, xv] using hx)) (allowed.2 hu).1)
          · exact h.comparable w hu x y (by simpa [adopted, two, setAt, xv] using hx) (by simpa [adopted, two, setAt, yv] using hy)
      · exact h.comparable u hu x y (by simpa [adopted, two, setAt, uw] using hx) (by simpa [adopted, two, setAt, uw] using hy)
  | sign => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩
  | release => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩
  | effect => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩
  | fence => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩
  | record => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩
  | replay => exact ⟨oldKnown, h.active_visited, h.below, h.comparable⟩

private theorem step_history {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) :
    (∀ tx w, w ∈ c.committee.core → t.signatures tx w = true → t.visited w (c.opVersion tx) = true) ∧
    (∀ tx w, w ∈ c.committee.core → t.signatures tx w = true → ∀ v,
      t.visited w v = true → (c.opVersion tx).val < v.val → held c v tx = true) := by
  cases st with
  | sign tx w allowed =>
    constructor
    · intro x u hu hx
      by_cases xt : x = tx
      · subst x
        by_cases uw : u = w
        · subst u; simpa [(allowed hu).2.1] using h.active_visited w hu
        · exact h.signed_visited tx u hu (by simpa [signed, two, setAt, uw] using hx)
      · exact h.signed_visited x u hu (by simpa [signed, two, setAt, xt] using hx)
    · intro x u hu hx v hv lower
      by_cases xt : x = tx
      · subst x
        by_cases uw : u = w
        · subst u
          have bound := (h.below w hu v hv).rank
          have active := (allowed hu).2.1
          rw [active] at bound
          omega
        · exact h.coverage tx u hu (by simpa [signed, two, setAt, uw] using hx) v hv lower
      · exact h.coverage x u hu (by simpa [signed, two, setAt, xt] using hx) v hv lower
  | adopt v w allowed =>
    constructor
    · intro x u hu hx
      have prior := h.signed_visited x u hu hx
      by_cases uw : u = w <;> by_cases xv : c.opVersion x = v <;> simp_all [adopted, two, setAt]
    · intro x u hu hx y hy lower
      by_cases uw : u = w
      · subst u
        by_cases yv : y = v
        · subst y; exact (allowed.2 hu).2 x hx
        · exact h.coverage x w hu hx y (by simpa [adopted, two, setAt, yv] using hy) lower
      · exact h.coverage x u hu hx y (by simpa [adopted, two, setAt, uw] using hy) lower
  | release => exact ⟨h.signed_visited, h.coverage⟩
  | effect => exact ⟨h.signed_visited, h.coverage⟩
  | fence => exact ⟨h.signed_visited, h.coverage⟩
  | record => exact ⟨h.signed_visited, h.coverage⟩
  | replay => exact ⟨h.signed_visited, h.coverage⟩

private theorem step_evidence {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) :
    (∀ tx w, w ∈ c.committee.core → ¬ (t.effects tx w = true ∧ t.fences tx w = true)) ∧
    (∀ tx w, w ∈ c.committee.core → t.effects tx w = true → operationCert c t tx = true) ∧
    (∀ tx w, w ∈ c.committee.core → t.released tx w = true → cancelCert c t tx = true) := by
  have j := step_journals st
  have ops := fun tx w hw vote => quorum_mono c _ _ (j.signatures tx) (h.effect_operation tx w hw vote)
  have cancels := fun tx w hw vote => quorum_mono c _ _ (j.fences tx) (h.release_cancel tx w hw vote)
  cases st with
  | effect tx w allowed =>
    refine ⟨?_, ?_, cancels⟩
    · intro x u hu ⟨effectVote, fenceVote⟩
      by_cases xt : x = tx
      · subst x
        by_cases uw : u = w
        · subst u; have noFence := (allowed hu).2; simp [emitted, noFence] at fenceVote
        · exact h.discipline tx u hu ⟨by simpa [emitted, two, setAt, uw] using effectVote, fenceVote⟩
      · exact h.discipline x u hu ⟨by simpa [emitted, two, setAt, xt] using effectVote, fenceVote⟩
    · intro x u hu hx
      by_cases xt : x = tx
      · subst x
        by_cases uw : u = w
        · subst u; exact (allowed hu).1
        · exact ops tx u hu (by simpa [emitted, two, setAt, uw] using hx)
      · exact ops x u hu (by simpa [emitted, two, setAt, xt] using hx)
  | fence tx w allowed =>
    refine ⟨?_, ops, cancels⟩
    intro x u hu ⟨effectVote, fenceVote⟩
    by_cases xt : x = tx
    · subst x
      by_cases uw : u = w
      · subst u; have noEffect := (allowed hu).2; simp [fenced, noEffect] at effectVote
      · exact h.discipline tx u hu ⟨effectVote, by simpa [fenced, two, setAt, uw] using fenceVote⟩
    · exact h.discipline x u hu ⟨effectVote, by simpa [fenced, two, setAt, xt] using fenceVote⟩
  | release tx w certificate =>
    refine ⟨h.discipline, ops, ?_⟩
    intro x u hu hx
    by_cases xt : x = tx
    · subst x
      by_cases uw : u = w
      · subst u; exact certificate
      · exact cancels tx u hu (by simpa [released, two, setAt, uw] using hx)
    · exact cancels x u hu (by simpa [released, two, setAt, xt] using hx)
  | sign => exact ⟨h.discipline, ops, cancels⟩
  | record => exact ⟨h.discipline, ops, cancels⟩
  | adopt => exact ⟨h.discipline, ops, cancels⟩
  | replay => exact ⟨h.discipline, ops, cancels⟩

private theorem step_auth {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) : ∀ tx w, w ∈ c.committee.core → t.signatures tx w = true → c.authorized tx = true := by
  cases st with
  | sign tx w allowed =>
    intro x u hu hx
    by_cases xt : x = tx
    · subst x
      by_cases uw : u = w
      · subst u; exact (allowed hu).1
      · exact h.signature_auth tx u hu (by simpa [signed, two, setAt, uw] using hx)
    · exact h.signature_auth x u hu (by simpa [signed, two, setAt, xt] using hx)
  | release => exact h.signature_auth
  | effect => exact h.signature_auth
  | fence => exact h.signature_auth
  | record => exact h.signature_auth
  | adopt => exact h.signature_auth
  | replay => exact h.signature_auth

theorem step_invariant {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) : Invariant c t := by
  obtain ⟨vk,av,bl,co⟩ := step_lineage h st
  obtain ⟨sv,cv⟩ := step_history h st
  obtain ⟨di,eo,rc⟩ := step_evidence h st
  exact ⟨step_known h st, vk,av,bl,co,sv,cv,di,eo,rc,step_capacity h st,step_auth h st⟩

/-- An arbitrary finite asynchronous execution, including stuttering. -/
inductive Run (c : Config V T R f) : State V T → State V T → Prop where
  | refl (s) : Run c s s
  | next {s t u} : Run c s t → Step c t u → Run c s u

theorem run_invariant {c : Config V T R f} {s t} (h : Invariant c s)
    (run : Run c s t) : Invariant c t := by
  induction run with
  | refl => exact h
  | next _ st ih => exact step_invariant ih st

theorem certified_comparable {c : Config V T R f} {s} (h : Invariant c s)
    {a b : Fin T} (qa : operationCert c s a = true) (qb : operationCert c s b = true) :
    Ancestor c.graph (c.opVersion a) (c.opVersion b) ∨ Ancestor c.graph (c.opVersion b) (c.opVersion a) := by
  obtain ⟨w,hw,ha,hb⟩ := honest_intersection c.committee _ _ (of_decide_eq_true qa) (of_decide_eq_true qb)
  exact h.comparable w hw _ _ (h.signed_visited a w hw ha) (h.signed_visited b w hw hb)

/-- Old operation certificates are covered, including certificates assembled
AFTER adoption from signatures that existed before adoption. -/
theorem certified_coverage {c : Config V T R f} {s} (h : Invariant c s)
    {a b : Fin T} (qa : operationCert c s a = true) (qb : operationCert c s b = true)
    (earlier : (c.opVersion a).val < (c.opVersion b).val) : held c (c.opVersion b) a = true := by
  obtain ⟨w,hw,ha,hb⟩ := honest_intersection c.committee _ _ (of_decide_eq_true qa) (of_decide_eq_true qb)
  exact h.coverage a w hw ha _ (h.signed_visited b w hw hb) earlier

theorem final_operation {c : Config V T R f} {s} (h : Invariant c s)
    {tx} (q : finalCert c s tx = true) : operationCert c s tx = true := by
  obtain ⟨w,hw,ha,_⟩ := honest_intersection c.committee _ _ (of_decide_eq_true q) (of_decide_eq_true q)
  exact h.effect_operation tx w hw ha

theorem final_cancel_exclusive {c : Config V T R f} {s} (h : Invariant c s)
    {tx} (q : finalCert c s tx = true) (cancel : cancelCert c s tx = true) : False := by
  obtain ⟨w,hw,ha,hb⟩ := honest_intersection c.committee _ _ (of_decide_eq_true q) (of_decide_eq_true cancel)
  exact h.discipline tx w hw ⟨ha,hb⟩

/-- Select finalized transactions belonging to one immutable version. -/
def currentFinal (c : Config V T R f) (s : State V T) (v : Version V) (tx : Fin T) : Bool :=
  finalCert c s tx && decide (c.opVersion tx = v)

theorem version_final_bound {c : Config V T R f} {s} (h : Invariant c s)
    (v : Version V) (d : Fin R) :
    sumOn ((List.finRange T).filter (currentFinal c s v)) (fun tx => c.cost tx d) ≤ allowance c v d := by
  apply CBCL.ConsensusFree.certified_bound c.committee _ _ s.signatures
  · intro tx ht
    have final : finalCert c s tx = true := (Bool.and_eq_true_iff.mp (List.mem_filter.mp ht).2).1
    exact of_decide_eq_true (final_operation h final)
  · intro w hw
    apply Nat.le_trans _ (h.capacity v w hw d)
    rw [CBCL.ConsensusFree.sumOn_filter]
    apply sumOn_mono
    intro tx _
    by_cases relevant : currentFinal c s v tx = true
    · have data : finalCert c s tx = true ∧ c.opVersion tx = v := by simpa [currentFinal] using relevant
      have neverReleased : s.released tx w = false := by
        cases released : s.released tx w with
        | false => rfl
        | true => exact False.elim (final_cancel_exclusive h data.1 (h.release_cancel tx w hw released))
      simp [relevant, data.2, neverReleased]
    · simp [relevant]

private theorem max_witness (xs : List α) (p : α → Bool) (rank : α → Nat) :
    (∀ x ∈ xs, p x = false) ∨ ∃ m ∈ xs, p m = true ∧ ∀ x ∈ xs, p x = true → rank x ≤ rank m := by
  induction xs with
  | nil => exact Or.inl (by simp)
  | cons x xs ih =>
    rcases ih with empty | ⟨m,hm,pm,bound⟩
    · cases hx : p x with
      | false => exact Or.inl (by intro y hy; rcases List.mem_cons.mp hy with rfl | hy; exact hx; exact empty y hy)
      | true => exact Or.inr ⟨x,by simp,hx,by
          intro y hy py
          rcases List.mem_cons.mp hy with rfl | hy
          · exact Nat.le_refl _
          · have := empty y hy; simp_all⟩
    · cases hx : p x with
      | false => exact Or.inr ⟨m,by simp [hm],pm,by
          intro y hy py
          rcases List.mem_cons.mp hy with rfl | hy
          · simp_all
          · exact bound y hy py⟩
      | true =>
        by_cases le : rank x ≤ rank m
        · exact Or.inr ⟨m,by simp [hm],pm,by
            intro y hy py
            rcases List.mem_cons.mp hy with rfl | hy
            · exact le
            · exact bound y hy py⟩
        · exact Or.inr ⟨x,by simp,hx,by
            intro y hy py
            rcases List.mem_cons.mp hy with rfl | hy
            · exact Nat.le_refl _
            · have := bound y hy py; omega⟩

/-- Held costs excluding IDs refunded by cancellation certificates. -/
def netHeld (c : Config V T R f) (v : Version V) (d : Fin R) : Nat :=
  markedNat (fun tx => held c v tx && !refunded c v tx) (fun tx => c.cost tx d)
/-- Sum unique finalized debits over the finite transaction universe. -/
def totalDebit (c : Config V T R f) (s : State V T) (d : Fin R) : Nat :=
  markedNat (finalCert c s) (fun tx => c.cost tx d)
/-- Sum unique finalized credits over the finite transaction universe. -/
def totalCredit (c : Config V T R f) (s : State V T) (d : Fin R) : Nat :=
  markedNat (finalCert c s) (fun tx => c.credit tx d)
/-- Sum the unique credits imported by a manifest. -/
def manifestCredit (c : Config V T R f) (v : Version V) (d : Fin R) : Nat :=
  markedNat (credited c v) (fun tx => c.credit tx d)
/-- Derived business observation; admission never consults this global quantity. -/
def balance (c : Config V T R f) (s : State V T) (d : Fin R) : Int :=
  (c.initial d : Int) + (totalCredit c s d : Int) - (totalDebit c s d : Int)

private theorem static_refund {c : Config V T R f} {v} (valid : Static c v)
    (tx) (ht : refunded c v tx = true) : held c v tx = true := by
  rcases valid with root | valid
  · simp [refunded,root] at ht
  · exact valid.2.2.2.2.2.2.1 tx ht

private theorem static_books {c : Config V T R f} {v} (valid : Static c v) (d : Fin R) :
    (allowance c v d : Int) = (c.initial d : Int) + (manifestCredit c v d : Int) - (netHeld c v d : Int) := by
  have heldEq : markedNat (held c v) (fun tx => c.cost tx d) =
      netHeld c v d + markedNat (refunded c v) (fun tx => c.cost tx d) := by
    simp only [netHeld, markedNat]
    rw [← sumOn_add]
    apply Nat.le_antisymm <;> apply sumOn_mono <;> intro tx _ <;>
      have sub := static_refund valid tx
    all_goals cases ha : held c v tx <;> cases hb : refunded c v tx <;> simp_all
  rcases valid with root | valid
  · simp [allowance,manifestCredit,netHeld,credited,held,refunded,root,markedNat]
  · have books := valid.2.2.2.2.2.2.2.2 d
    rw [marked_cast,marked_cast,marked_cast] at books
    change (allowance c v d : Int) = (c.initial d : Int) + (manifestCredit c v d : Int) -
      (markedNat (held c v) (fun tx => c.cost tx d) : Int) +
      (markedNat (refunded c v) (fun tx => c.cost tx d) : Int) at books
    omega

/-- Maximal FINALIZED version is chosen only in this proof, not by any node.
Local admission never consults a global frontier or global balance. -/
theorem resource_nonnegative {c : Config V T R f} {s} (h : Invariant c s) (d : Fin R) :
    0 ≤ balance c s d := by
  rcases max_witness (List.finRange T) (finalCert c s) (fun tx => (c.opVersion tx).val) with
    empty | ⟨m,hm,fm,bound⟩
  · have credits : totalCredit c s d = 0 := by
      simp only [totalCredit,markedNat]
      have same := fun tx ht => empty tx ht
      have eq := sumOn_mono (List.finRange T) (fun tx => if finalCert c s tx then c.credit tx d else 0) (fun _ => 0)
        (by intro tx ht; simp [same tx ht])
      simp at eq; omega
    have debits : totalDebit c s d = 0 := by
      simp only [totalDebit,markedNat]
      have eq := sumOn_mono (List.finRange T) (fun tx => if finalCert c s tx then c.cost tx d else 0) (fun _ => 0)
        (by intro tx ht; simp [empty tx ht])
      simp at eq; omega
    simp [balance,credits,debits]
  · let v := c.opVersion m
    have qm := final_operation h fm
    obtain ⟨w,hw,hs,_⟩ := honest_intersection c.committee _ _ (of_decide_eq_true qm) (of_decide_eq_true qm)
    have known := h.visited_known w hw v (h.signed_visited m w hw hs)
    obtain ⟨valid,creditFinal,refundCancel⟩ := h.known v known
    have partition : totalDebit c s d ≤ netHeld c v d +
        sumOn ((List.finRange T).filter (currentFinal c s v)) (fun tx => c.cost tx d) := by
      unfold totalDebit netHeld markedNat
      rw [CBCL.ConsensusFree.sumOn_filter, ← sumOn_add]
      apply sumOn_mono
      intro tx ht
      by_cases finalized : finalCert c s tx = true
      · by_cases here : c.opVersion tx = v
        · simp [currentFinal,finalized,here]
        · have less : (c.opVersion tx).val < v.val := by
            have le := bound tx ht finalized
            have ne : (c.opVersion tx).val ≠ v.val := by intro eq; exact here (Fin.ext eq)
            change (c.opVersion tx).val ≤ v.val at le
            omega
          have carried := certified_coverage h (final_operation h finalized) qm less
          change held c v tx = true at carried
          have notRefunded : refunded c v tx = false := by
            cases flag : refunded c v tx with
            | false => rfl
            | true => exact False.elim (final_cancel_exclusive h finalized (refundCancel tx flag))
          simp [finalized,carried,notRefunded]
      · simp [finalized,currentFinal]
    have cap := version_final_bound h v d
    have credits : manifestCredit c v d ≤ totalCredit c s d := by
      apply sumOn_mono
      intro tx _
      by_cases hc : credited c v tx = true
      · simp [hc,creditFinal tx hc]
      · simp [hc]
    have books := static_books valid d
    unfold balance
    omega

/-- Releasing a reservation only with a cancellation QC excludes finalization,
even after any future sequence of asynchronous steps. -/
theorem release_future_safe {c : Config V T R f} {s t} (h : Invariant c s)
    (run : Run c s t) {tx w} (hw : w ∈ c.committee.core) (rel : s.released tx w = true) :
    finalCert c t tx = false := by
  have cancel := h.release_cancel tx w hw rel
  have mono : cancelCert c t tx = true := by
    induction run with
    | refl => exact cancel
    | next _ st ih => exact quorum_mono c _ _ ((step_journals st).fences tx) ih
  cases hf : finalCert c t tx with
  | false => rfl
  | true => exact False.elim (final_cancel_exclusive (run_invariant h run) hf mono)

private theorem balance_ext {c : Config V T R f} {s t : State V T}
    (same : ∀ tx, finalCert c t tx = finalCert c s tx) : balance c t = balance c s := by
  funext d
  unfold balance totalCredit totalDebit markedNat
  simp only [same]

private theorem final_delta {c : Config V T R f} {s t : State V T} {tx}
    (before : finalCert c s tx = false) (after : finalCert c t tx = true)
    (other : ∀ u, u ≠ tx → finalCert c t u = finalCert c s u) (d : Fin R) :
    balance c t d = balance c s d + c.credit tx d - c.cost tx d := by
  have sum_delta : ∀ weight : Fin T → Nat,
      (markedNat (finalCert c t) weight : Int) = (markedNat (finalCert c s) weight : Int) + weight tx := by
    intro weight
    rw [← marked_cast, ← marked_cast]
    have eq : (fun u => if finalCert c t u then (weight u : Int) else 0) =
        setAt (fun u => if finalCert c s u then (weight u : Int) else 0) tx (weight tx) := by
      funext u
      by_cases ut : u = tx
      · subst u; simp [setAt,after]
      · simp [setAt,ut,other u ut]
    rw [eq,CBCL.ConsensusFree.isum_update _ _ tx _ (CBCL.ConsensusFree.finRange_unique _) (by simp)]
    simp [before]
  have cr := sum_delta (fun u => c.credit u d)
  have db := sum_delta (fun u => c.cost u d)
  unfold balance totalCredit totalDebit
  omega

/-- Every concrete step either stutters or performs one AUTHORIZED, FUNDED
business action. Endpoint safety is derived above, never an admission premise. -/
def BusinessStep (c : Config V T R f) (s t : State V T) : Prop :=
  balance c t = balance c s ∨ ∃ tx, c.authorized tx = true ∧
    (∀ d, (c.cost tx d : Int) ≤ balance c s d) ∧
    (∀ d, balance c t d = balance c s d + c.credit tx d - c.cost tx d)

theorem step_refinement {c : Config V T R f} {s t} (h : Invariant c s)
    (st : Step c s t) : BusinessStep c s t := by
  have ht := step_invariant h st
  cases st with
  | effect tx w allowed =>
    have others : ∀ u, u ≠ tx → finalCert c (emitted s tx w) u = finalCert c s u := by
      intro u hu
      simp [finalCert,emitted,two,setAt,hu]
    cases hb : finalCert c s tx with
    | true =>
      apply Or.inl; apply balance_ext
      intro u
      by_cases ut : u = tx
      · subst u
        have mono := quorum_mono c _ _ (two_mono s.effects tx w tx) hb
        exact mono.trans hb.symm
      · exact others u ut
    | false =>
      cases ha : finalCert c (emitted s tx w) tx with
      | false =>
        apply Or.inl; apply balance_ext
        intro u
        by_cases ut : u = tx
        · subst u; exact ha.trans hb.symm
        · exact others u ut
      | true =>
        have qo := final_operation ht ha
        obtain ⟨v,hv,hs,_⟩ := honest_intersection c.committee _ _ (of_decide_eq_true qo) (of_decide_eq_true qo)
        refine Or.inr ⟨tx,ht.signature_auth tx v hv hs,?_,final_delta hb ha others⟩
        intro d
        have before := resource_nonnegative h d
        have after := resource_nonnegative ht d
        have delta := final_delta hb ha others d
        rcases c.disjoint tx d with zeroCost | zeroCredit
        · simp [zeroCost]; exact before
        · rw [zeroCredit] at delta; omega
  | sign => exact Or.inl rfl
  | release => exact Or.inl rfl
  | fence => exact Or.inl rfl
  | record => exact Or.inl rfl
  | adopt => exact Or.inl rfl
  | replay => exact Or.inl rfl

/-- Finite business execution allowing internal stuttering steps. -/
inductive BusinessRun (c : Config V T R f) : State V T → State V T → Prop where
  | refl (s) : BusinessRun c s s
  | next {s t u} : BusinessRun c s t → BusinessStep c t u → BusinessRun c s u

theorem finite_refinement {c : Config V T R f} {s}
    (run : Run c initial s) : BusinessRun c initial s := by
  induction run with
  | refl => exact .refl _
  | next prev st ih => exact .next ih (step_refinement (run_invariant (initial_invariant c) prev) st)

theorem infinite_refinement {c : Config V T R f} (trace : Nat → State V T)
    (start : trace 0 = initial) (steps : ∀ n, Step c (trace n) (trace (n+1))) :
    ∀ n, Invariant c (trace n) ∧ BusinessStep c (trace n) (trace (n+1)) ∧
      ∀ d, 0 ≤ balance c (trace n) d := by
  have inv : ∀ n, Invariant c (trace n) := by
    intro n; induction n with
    | zero => rw [start]; exact initial_invariant c
    | succ n ih => exact step_invariant ih (steps n)
  intro n
  exact ⟨inv n,step_refinement (inv n) (steps n),resource_nonnegative (inv n)⟩

/-- Executable adversarial scheduler actions for the formal model. -/
inductive Command (V T : Nat) where
  | sign (tx : Fin T) (w : Nat)
  | release (tx : Fin T) (w : Nat)
  | effect (tx : Fin T) (w : Nat)
  | fence (tx : Fin T) (w : Nat)
  | record (v : Version V)
  | adopt (v : Version V) (w : Nat)
  | replay
  deriving Repr

/-- Execute local guards; honest-core membership is proof-only adversary classification. -/
def perform (c : Config V T R f) (s : State V T) : Command V T → Option (State V T)
  | .sign tx w => if SignAllowed c s tx w then some (signed s tx w) else none
  | .release tx w => if cancelCert c s tx then some (released s tx w) else none
  | .effect tx w => if w ∈ c.committee.core → operationCert c s tx = true ∧ s.fences tx w = false
      then some (emitted s tx w) else none
  | .fence tx w => if w ∈ c.committee.core → c.cancelAuthorized tx = true ∧ s.effects tx w = false
      then some (fenced s tx w) else none
  | .record v => if Live c s v then some (recorded s v) else none
  | .adopt v w => if AdoptAllowed c s v w then some (adopted s v w) else none
  | .replay => some s

theorem perform_sound {c : Config V T R f} {s t} {cmd : Command V T}
    (result : perform c s cmd = some t) : Step c s t := by
  cases cmd with
  | sign tx w =>
    simp only [perform] at result
    split at result
    · cases result; exact .sign _ _ _ (by assumption)
    · contradiction
  | release tx w =>
    simp only [perform] at result
    split at result
    · cases result; exact .release _ _ _ (by assumption)
    · contradiction
  | effect tx w =>
    simp only [perform] at result
    split at result
    · cases result; exact .effect _ _ _ (by assumption)
    · contradiction
  | fence tx w =>
    simp only [perform] at result
    split at result
    · cases result; exact .fence _ _ _ (by assumption)
    · contradiction
  | record v =>
    simp only [perform] at result
    split at result
    · cases result; exact .record _ _ (by assumption)
    · contradiction
  | adopt v w =>
    simp only [perform] at result
    split at result
    · cases result; exact .adopt _ _ _ (by assumption)
    · contradiction
  | replay => cases result; exact .replay _

/-- Run a script, rejecting at the first failed guard. -/
def execute (c : Config V T R f) (s : State V T) : List (Command V T) → Option (State V T)
  | [] => some s
  | cmd :: rest => (perform c s cmd).bind (fun t => execute c t rest)

theorem execute_sound {c : Config V T R f} {s t} {cmds}
    (result : execute c s cmds = some t) : Run c s t := by
  induction cmds generalizing s with
  | nil => simp only [execute,Option.some.injEq] at result; subst t; exact .refl _
  | cons cmd rest ih =>
    simp only [execute] at result
    cases hp : perform c s cmd with
    | none => simp [hp] at result
    | some u =>
      simp only [hp,Option.bind_some] at result
      have tail := ih result
      have head := perform_sound hp
      have trans : ∀ {a b z}, Run c a b → Run c b z → Run c a z := by
        intro a b z ab bz
        induction bz with
        | refl => exact ab
        | next _ step ih => exact .next ih step
      exact trans (.next (.refl _) head) tail

end CBCL.ConsensusFree.MultiParent
