;; Plan: Address quality issues from March 2026 review of CBCL Lean 4 formalization
;; Supersedes previous plan (all prior tasks completed)

(meta plan
  (id "CBCL-LEAN-QUALITY-V2")
  (title "CBCL Lean 4 Quality Improvements — Round 2")
  (version "2.0.0")
  (status "active")
  (created "2026-03-20")
  (author "agent:claude")
  (description "Address quality issues identified in second review: vacuous tautologies, DFS↔mutual-recursion gap, namespace hygiene, and proof verbosity."))

;; ============================================================
;; Agents
;; ============================================================

(given agent-claude-available)

;; ============================================================
;; Tasks
;; ============================================================

(given task-remove-tautologies)
(given task-dfs-mutual-link)
(given task-namespace-hygiene)
(given task-simplify-lang-sound)
(given task-escape-comment)

;; ============================================================
;; Task metadata
;; ============================================================

(meta task-remove-tautologies
  (description "Remove 5 vacuous termination/totality theorems that prove trivial ∃ result, f x = result")
  (acceptance "parse_terminates, boundedEval_terminates, boundedEvalFull_terminates, pipeline_terminates, serialize_total, tokenToAtom_total removed; lake build passes")
  (files "Parser.lean R2ResourceBounds.lean Pipeline.lean Serializer.lean")
  (priority "high"))

(meta task-dfs-mutual-link
  (description "Prove that dfsCheckNoCycles d = true implies ¬ mutualRecursion d, connecting the computable DFS checker to the logical mutual recursion predicate. Remove noncomputable verifyR1NoMutualRecursion.")
  (acceptance "A theorem dfsCheckNoCycles_no_mutual_recursion linking dfsCheckNoCycles to ¬mutualRecursion compiles; noncomputable verifyR1NoMutualRecursion removed; lake build passes")
  (files "R1NoRecursion.lean")
  (priority "high"))

(meta task-namespace-hygiene
  (description "Move decEqSExpr/decEqSExprList mutual block and DecidableEq instance into CBCL namespace")
  (acceptance "decEqSExpr, decEqSExprList not in global scope; instance DecidableEq CBCL.SExpr inside CBCL namespace; lake build passes")
  (files "SExpr.lean")
  (priority "medium"))

(meta task-simplify-lang-sound
  (description "Reduce langLanguage_sound proof from 108 lines of nested case-split to a more concise proof")
  (acceptance "langLanguage_sound compiles in ≤40 lines; no sorry; lake build passes")
  (files "DeterministicUnion.lean")
  (priority "low"))

(meta task-escape-comment
  (description "Add a comment to readStr documenting that escape sequences other than backslash and double-quote are treated as literal characters (backslash dropped)")
  (acceptance "Comment present at readStr; no code changes; lake build passes")
  (files "Parser.lean")
  (priority "low"))

;; ============================================================
;; Dependencies
;; ============================================================

;; All tasks are independent — can be done in parallel
(given no-deps-remove-tautologies)
(given no-deps-dfs-mutual-link)
(given no-deps-namespace-hygiene)
(given no-deps-simplify-lang-sound)
(given no-deps-escape-comment)

;; ============================================================
;; Readiness rules
;; ============================================================

(normally r-ready-remove-tautologies
  (and task-remove-tautologies no-deps-remove-tautologies)
  ready-remove-tautologies)

(normally r-ready-dfs-mutual-link
  (and task-dfs-mutual-link no-deps-dfs-mutual-link)
  ready-dfs-mutual-link)

(normally r-ready-namespace-hygiene
  (and task-namespace-hygiene no-deps-namespace-hygiene)
  ready-namespace-hygiene)

(normally r-ready-simplify-lang-sound
  (and task-simplify-lang-sound no-deps-simplify-lang-sound)
  ready-simplify-lang-sound)

(normally r-ready-escape-comment
  (and task-escape-comment no-deps-escape-comment)
  ready-escape-comment)

;; ============================================================
;; Assignment rules
;; ============================================================

(normally r-assign-remove-tautologies
  (and ready-remove-tautologies agent-claude-available)
  assign-to-remove-tautologies-claude)

(normally r-assign-dfs-mutual-link
  (and ready-dfs-mutual-link agent-claude-available)
  assign-to-dfs-mutual-link-claude)

(normally r-assign-namespace-hygiene
  (and ready-namespace-hygiene agent-claude-available)
  assign-to-namespace-hygiene-claude)

(normally r-assign-simplify-lang-sound
  (and ready-simplify-lang-sound agent-claude-available)
  assign-to-simplify-lang-sound-claude)

(normally r-assign-escape-comment
  (and ready-escape-comment agent-claude-available)
  assign-to-escape-comment-claude)

;; ============================================================
;; Priority: high first, then medium, then low
;; ============================================================

(prefer r-assign-remove-tautologies r-assign-namespace-hygiene)
(prefer r-assign-remove-tautologies r-assign-simplify-lang-sound)
(prefer r-assign-remove-tautologies r-assign-escape-comment)
(prefer r-assign-dfs-mutual-link r-assign-namespace-hygiene)
(prefer r-assign-dfs-mutual-link r-assign-simplify-lang-sound)
(prefer r-assign-dfs-mutual-link r-assign-escape-comment)
(prefer r-assign-namespace-hygiene r-assign-simplify-lang-sound)
(prefer r-assign-namespace-hygiene r-assign-escape-comment)
(prefer r-assign-simplify-lang-sound r-assign-escape-comment)

;; ============================================================
;; Rule metadata
;; ============================================================

(meta r-ready-remove-tautologies
  (description "Tautology removal has no dependencies")
  (justification "Each theorem is self-contained and can be deleted independently"))

(meta r-ready-dfs-mutual-link
  (description "DFS-mutual link has no dependencies")
  (justification "The existing DFS code and mutual recursion predicate are already in R1NoRecursion.lean"))

(meta r-assign-remove-tautologies
  (description "High priority: these mislead readers about what the formalization proves")
  (justification "Vacuous ∃ result, f x = result theorems are tautologies that add no value"))

(claims agent:claude
  :at "2026-03-20T04:07:51Z"
  (given claim-v1-remove-tautologies)
  (normally r-cl-state-v1-remove-tautologies claim-v1-remove-tautologies state-claimed-v1-remove-tautologies)
  (normally r-cl-chain-v1-remove-tautologies state-claimed-v1-remove-tautologies claimed-remove-tautologies)
)

