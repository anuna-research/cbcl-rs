;; Plan: Close remaining proof gaps in CBCL Lean 4 formalization — Round 3
;; Supersedes v2 plan (all v2 tasks completed)

(meta plan
  (id "CBCL-LEAN-QUALITY-V3")
  (title "CBCL Lean 4 — Close Remaining Proof Gaps")
  (version "3.0.0")
  (status "active")
  (created "2026-03-20")
  (author "agent:claude")
  (description "Address the 4 remaining proof gaps: round-trip theorem (prove), R4 (skip—crypto), boundedEval (remove dead code), DFS completeness (attempt)."))

;; ============================================================
;; Agents
;; ============================================================

(given agent-claude-available)

;; ============================================================
;; Tasks
;; ============================================================

(given task-roundtrip-proof)
(given task-remove-bounded-eval)
(given task-dfs-completeness)

;; ============================================================
;; Task metadata
;; ============================================================

(meta task-roundtrip-proof
  (description "Prove RoundTrippable' e → RoundTrippable e: the structural characterization implies actual parse∘serialize round-tripping")
  (acceptance "theorem roundtrippable_of_structural : RoundTrippable' e → RoundTrippable e compiles without sorry; lake build passes")
  (file "LeanCbcl/Serializer.lean")
  (priority "high"))

(meta task-remove-bounded-eval
  (description "Remove boundedEval (dead code: evaluates head only, discards result) and its associated theorems. Keep boundedEvalFull which correctly processes all children.")
  (acceptance "boundedEval, boundedEval_zero, boundedEval_atom removed; boundedEvalFull and its theorems retained; lake build passes")
  (file "LeanCbcl/R2ResourceBounds.lean")
  (priority "medium"))

(meta task-dfs-completeness
  (description "Prove DFS completeness: if there IS a cycle in the dependency graph, dfsCheckNoCycles returns false. This is the converse of the existing soundness theorem.")
  (acceptance "theorem dfs_complete or equivalent compiles without sorry; lake build passes. If infeasible due to fuel adequacy, document the gap and block the task.")
  (file "LeanCbcl/R1NoRecursion.lean")
  (priority "low"))

;; ============================================================
;; Dependencies
;; ============================================================

(given no-deps-roundtrip-proof)
(given no-deps-remove-bounded-eval)
(given no-deps-dfs-completeness)

;; ============================================================
;; Readiness rules
;; ============================================================

(normally r-ready-roundtrip-proof
  (and task-roundtrip-proof no-deps-roundtrip-proof)
  ready-roundtrip-proof)

(normally r-ready-remove-bounded-eval
  (and task-remove-bounded-eval no-deps-remove-bounded-eval)
  ready-remove-bounded-eval)

(normally r-ready-dfs-completeness
  (and task-dfs-completeness no-deps-dfs-completeness)
  ready-dfs-completeness)

;; ============================================================
;; Assignment rules
;; ============================================================

(normally r-assign-roundtrip-proof
  (and ready-roundtrip-proof agent-claude-available)
  assign-to-roundtrip-proof-claude)

(normally r-assign-remove-bounded-eval
  (and ready-remove-bounded-eval agent-claude-available)
  assign-to-remove-bounded-eval-claude)

(normally r-assign-dfs-completeness
  (and ready-dfs-completeness agent-claude-available)
  assign-to-dfs-completeness-claude)

;; ============================================================
;; Priority
;; ============================================================

(prefer r-assign-roundtrip-proof r-assign-remove-bounded-eval)
(prefer r-assign-roundtrip-proof r-assign-dfs-completeness)
(prefer r-assign-remove-bounded-eval r-assign-dfs-completeness)

(claims agent:claude
  :at "2026-03-20T04:55:11Z"
  (given claim-v1-roundtrip-proof)
  (normally r-cl-state-v1-roundtrip-proof claim-v1-roundtrip-proof state-claimed-v1-roundtrip-proof)
  (normally r-cl-chain-v1-roundtrip-proof state-claimed-v1-roundtrip-proof claimed-roundtrip-proof)
)

(claims agent:claude
  :at "2026-03-20T04:55:11Z"
  (given claim-v1-remove-bounded-eval)
  (normally r-cl-state-v1-remove-bounded-eval claim-v1-remove-bounded-eval state-claimed-v1-remove-bounded-eval)
  (normally r-cl-chain-v1-remove-bounded-eval state-claimed-v1-remove-bounded-eval claimed-remove-bounded-eval)
)

(claims agent:claude
  :at "2026-03-20T04:55:11Z"
  (given claim-v1-dfs-completeness)
  (normally r-cl-state-v1-dfs-completeness claim-v1-dfs-completeness state-claimed-v1-dfs-completeness)
  (normally r-cl-chain-v1-dfs-completeness state-claimed-v1-dfs-completeness claimed-dfs-completeness)
)

(claims agent:claude
  :at "2026-03-20T04:55:58Z"
  (given completed-remove-bounded-eval))

(claims agent:claude
  :at "2026-03-20T05:07:37Z"
  (given completed-dfs-completeness))

(claims agent:claude
  :at "2026-03-20T05:23:35Z"
