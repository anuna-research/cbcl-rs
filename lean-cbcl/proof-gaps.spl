  (normally r-cl-chain-v1-dfs-mutual-link state-claimed-v1-dfs-mutual-link claimed-dfs-mutual-link)
)

(claims agent:claude
  :at "2026-03-20T04:07:51Z"
  (given claim-v1-namespace-hygiene)
  (normally r-cl-state-v1-namespace-hygiene claim-v1-namespace-hygiene state-claimed-v1-namespace-hygiene)
  (normally r-cl-chain-v1-namespace-hygiene state-claimed-v1-namespace-hygiene claimed-namespace-hygiene)
)

(claims agent:claude
  :at "2026-03-20T04:07:51Z"
  (given claim-v1-simplify-lang-sound)
  (normally r-cl-state-v1-simplify-lang-sound claim-v1-simplify-lang-sound state-claimed-v1-simplify-lang-sound)
  (normally r-cl-chain-v1-simplify-lang-sound state-claimed-v1-simplify-lang-sound claimed-simplify-lang-sound)
)

(claims agent:claude
  :at "2026-03-20T04:07:51Z"
  (given claim-v1-escape-comment)
  (normally r-cl-state-v1-escape-comment claim-v1-escape-comment state-claimed-v1-escape-comment)
  (normally r-cl-chain-v1-escape-comment state-claimed-v1-escape-comment claimed-escape-comment)
