{
  "name": "cbcl",
  "version": "0.1.0",
  "description": "CBCL for JavaScript: the verifier (parse, verify, fold, bind, compile) as typed wrappers over the cbcl-rs WebAssembly build, plus object and view authoring runtimes.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://git.anuna.io/anuna-research/cbcl-rs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "default": "./dist/object/index.js"
    },
    "./wasm": "./dist/cbcl_wasm.js",
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "examples/lunch-vote.mjs"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "cp ../LICENSE LICENSE && tsc -p tsconfig.json && cp src/cbcl_wasm.js src/cbcl_wasm.d.ts src/cbcl_wasm_bg.wasm src/cbcl_wasm_bg.wasm.d.ts src/cbcl_wasm.provenance.json dist/ && cp src/view/index.d.ts dist/view/ && cp ../dialects/lunch-vote.cbcl dist/",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:docs": "node --test scripts/docs.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node scripts/check-package.mjs",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "^5.7"
  }
}
